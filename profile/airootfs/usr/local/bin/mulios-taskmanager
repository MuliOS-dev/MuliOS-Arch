#!/usr/bin/env bash
set -Eeuo pipefail

APP=/usr/bin/mulios-taskmanager
if [[ ! -x "$APP" ]]; then
    message="MuliOS Task Manager is not installed: $APP"
    if command -v kdialog >/dev/null 2>&1 && [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        kdialog --title "MuliOS Task Manager" --error "$message" || true
    else
        printf "%s\n" "$message" >&2
    fi
    exit 1
fi

exec "$APP" "$@"
