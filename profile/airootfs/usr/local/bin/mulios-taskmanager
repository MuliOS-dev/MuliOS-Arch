#!/usr/bin/env bash
set -u

APP_DIR="/opt/taskmanager"
LAUNCHER="$APP_DIR/launcher.py"
LOG_DIR="$HOME/.local/state/mulios"
LOG_FILE="$LOG_DIR/taskmanager.log"

mkdir -p "$LOG_DIR"

if [ ! -f "$LAUNCHER" ]; then
    printf '%s\n' "MuliOS Task Manager is not installed." | tee -a "$LOG_FILE" >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "Python 3 is required by MuliOS Task Manager." | tee -a "$LOG_FILE" >&2
    exit 1
fi

cd "$APP_DIR" || exit 1
export PYTHONUNBUFFERED=1
if /usr/bin/python3 "$LAUNCHER" >>"$LOG_FILE" 2>&1; then
    exit 0
else
    status=$?
    if command -v kdialog >/dev/null 2>&1; then
        details="$(tail -n 18 "$LOG_FILE" 2>/dev/null || true)"
        kdialog --title "MuliOS Task Manager" --error "MuliOS Task Manager could not start (exit code $status).\n\nLog: $LOG_FILE\n\n$details" || true
    fi
    exit "$status"
fi
