#!/usr/bin/env bash
set -u

APP_DIR="/opt/credits"
LAUNCHER="$APP_DIR/main.py"
LOG_DIR="$HOME/.local/state/mulios"
LOG_FILE="$LOG_DIR/credits.log"

mkdir -p "$LOG_DIR"

if [ ! -f "$LAUNCHER" ]; then
    printf '%s\n' "MuliOS Credits is not installed." | tee -a "$LOG_FILE" >&2
    exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' "Python 3 is required by MuliOS Credits." | tee -a "$LOG_FILE" >&2
    exit 1
fi

cd "$APP_DIR" || exit 1
if /usr/bin/python3 "$LAUNCHER" >>"$LOG_FILE" 2>&1; then
    exit 0
else
    status=$?
    if command -v kdialog >/dev/null 2>&1; then
        details="$(tail -n 18 "$LOG_FILE" 2>/dev/null || true)"
        kdialog --title "MuliOS Credits" --error "MuliOS Credits could not start (exit code $status).\n\nLog: $LOG_FILE\n\n$details" || true
    fi
    exit "$status"
fi
