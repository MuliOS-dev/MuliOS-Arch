#!/usr/bin/env bash
set -Eeuo pipefail

# MUpdate
# Version: a1.0.6
#
# Source: https://github.com/MuliOS-dev/MuliOS-Arch
# Source tree: profile/airootfs
#
# Only new/changed MuliOS-owned files are downloaded.
# Files are never deleted as of now.
# Machine-specific state is protected.

VERSION="a1.0.6"
GITHUB_OWNER="MuliOS-dev"
GITHUB_REPO="MuliOS-Arch"
GITHUB_BRANCH="main"
BETA_MODE=0

STATE_DIR="/var/lib/mupdate"
LOG_FILE="/var/log/mupdate.log"
LOCK_FILE="$STATE_DIR/mupdate.lock"
WORKDIR="$(mktemp -d /tmp/mupdate.XXXXXX)"

ASSUME_YES=1
SAFE_MODE=0
DRY_RUN=0
FORCE_MODE=0

CHANGED_COUNT=0
ADDED_COUNT=0
SKIPPED_COUNT=0
REMOTE_VERSION=""
REMOTE_TREE_SHA=""

cleanup() {
    rm -rf "$WORKDIR"
}
trap cleanup EXIT
trap 'die "Interrupted."' INT TERM

log() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    printf '%s [MUpdate] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >> "$LOG_FILE" 2>/dev/null || true
}

info() {
    printf '\033[0;34m==>\033[0m %s\n' "$*" >&2
    log "INFO: $*"
}

ok() {
    printf '\033[0;32m==>\033[0m %s\n' "$*" >&2
    log "OK: $*"
}

warn() {
    printf '\033[0;33m==>\033[0m %s\n' "$*" >&2
    log "WARN: $*"
}

err() {
    printf '\033[0;31m==>\033[0m %s\n' "$*" >&2
    log "ERROR: $*"
}

die() {
    err "$*"
    exit 1
}

require_root() {
    [[ "$(id -u)" -eq 0 ]] || die "Run MUpdate with sudo."
}

require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "Missing required command: $cmd"
    done
}

check_dependencies() {
    require_cmd curl jq git sha1sum sha256sum install mkdir rm mktemp stat chmod readlink flock tar cp sed tr date head cat zip
}

create_backup() {
    local local_path="$1"
    local backup_root="$STATE_DIR/backups"
    local backup_stage="$WORKDIR/backup"
    local timestamp
    local archive

    [[ "$DRY_RUN" == "1" ]] && return 0
    [[ -e "$local_path" || -L "$local_path" ]] || return 0

    timestamp="$(date -u '+%Y%m%dT%H%M%S%NZ')"
    path_id="$(printf '%s' "$local_path" | sha256sum | sed 's/ .*//' | sed 's/^\(.\{12\}\).*$/\1/')"
    archive="$backup_root/mupdate-$timestamp-$path_id.zip"

    mkdir -p "$backup_root"
    rm -rf "$backup_stage"
    mkdir -p "$backup_stage$(dirname "$local_path")"

    cp -a "$local_path" "$backup_stage$local_path"

    (
        cd "$backup_stage"
        zip -q -r "$archive" .
    ) || {
        rm -f "$archive"
        warn "Unable to create backup archive for $local_path; refusing to overwrite it."
        return 1
    }

    ok "Backed up $local_path to $archive"
}

acquire_lock() {
    mkdir -p "$STATE_DIR"
    exec 200>"$LOCK_FILE"
    flock -n 200 || die "Another MUpdate process is already running."
}

verify_os() {
    [[ -r /etc/os-release ]] || die "/etc/os-release is missing."

    local id id_like
    id="$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')"
    id_like="$(sed -n 's/^ID_LIKE=//p' /etc/os-release | tr -d '"')"

    [[ "$id" == "mulios" && "$id_like" == *arch* ]] ||
        die "This is not an Arch-based MuliOS installation."
}

raw_url() {
    printf 'https://raw.githubusercontent.com/%s/%s/%s/%s\n' \
        "$GITHUB_OWNER" "$GITHUB_REPO" "$GITHUB_BRANCH" "$1"
}

get_tree() {
    curl -fsSL         --retry 3         --retry-all-errors         -H "Accept: application/vnd.github+json"         -H "X-GitHub-Api-Version: 2022-11-28"         "https://api.github.com/repos/$GITHUB_OWNER/$GITHUB_REPO/git/trees/$GITHUB_BRANCH?recursive=1"
}

is_protected() {
    local path="$1"
    case "$path" in
        profile/airootfs/etc/passwd|profile/airootfs/etc/shadow|profile/airootfs/etc/group|profile/airootfs/etc/gshadow|profile/airootfs/etc/hostname|profile/airootfs/etc/hosts|profile/airootfs/etc/machine-id|profile/airootfs/etc/localtime|profile/airootfs/etc/adjtime|profile/airootfs/etc/fstab|profile/airootfs/etc/crypttab|profile/airootfs/etc/ssh/*|profile/airootfs/etc/sddm.conf.d/autologin.conf|profile/airootfs/etc/sudoers.d/mulios-installer|profile/airootfs/etc/systemd/system/*|profile/airootfs/etc/mkinitcpio.conf.d/archiso.conf|profile/airootfs/etc/systemd/resolved.conf.d/archiso.conf|profile/airootfs/etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook|profile/airootfs/etc/pacman.d/hooks/uncomment-mirrors.hook|profile/airootfs/usr/local/bin/livecd-sound|profile/airootfs/usr/share/applications/mulios-installer.desktop|profile/airootfs/usr/share/applications/mulios-changelog.desktop|profile/airootfs/etc/xdg/autostart/mulios-welcome.desktop|profile/airootfs/etc/skel/Desktop/mulios-installer.desktop|profile/airootfs/opt/mulios-installer/*|profile/airootfs/opt/mulios-changelog/*|profile/airootfs/var/*|profile/airootfs/home/*|profile/airootfs/root/*|profile/airootfs/boot/*|profile/airootfs/efi/*)
            return 0
            ;;
    esac
    return 1
}

is_syncable() {
    [[ "$1" == profile/airootfs/* ]] || return 1
    is_protected "$1" && return 1
    return 0
}

local_blob_sha() {
    local repo_path="$1"
    local mode="$2"
    local local_path

    local_path="$(printf '%s' "$repo_path" | sed 's#^profile/airootfs##')"

    if [[ "$mode" == "120000" ]]; then
        [[ -L "$local_path" ]] || return 1
        local link_target
        link_target="$(readlink "$local_path")"
        printf '%s' "$link_target" | git hash-object --stdin
        return
    fi

    [[ -f "$local_path" ]] || return 1
    git hash-object "$local_path"
}

confirm() {
    [[ "$ASSUME_YES" == "1" ]] && return 0

    local reply
    read -r -p "? $1 [y/N] " reply

    case "$reply" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

merge_file() {
    local repo_path="$1"
    local mode="$2"
    local remote_sha="$3"
    local local_path

    local_path="$(printf '%s' "$repo_path" | sed 's#^profile/airootfs##')"

    if [[ "$mode" == "120000" ]]; then
        local link_target
        link_target="$(curl -fsSL --retry 3 --retry-all-errors "$(raw_url "$repo_path")")" ||
            die "Failed downloading symlink: $repo_path"

        local link_sha
        link_sha="$(printf '%s' "$link_target" | git hash-object --stdin)"
        [[ "$link_sha" == "$remote_sha" ]] || die "Repository changed while downloading symlink: $repo_path"

        if [[ "$DRY_RUN" == "1" ]]; then
            printf 'UPDATE LINK %s -> %s\n' "$local_path" "$link_target"
            return
        fi

        if ! create_backup "$local_path"; then
            ((SKIPPED_COUNT+=1))
            return 0
        fi

        rm -f "$local_path"
        mkdir -p "$(dirname "$local_path")"
        ln -s "$link_target" "$local_path"
        return
    fi

    local temp_file="$WORKDIR/file"
    curl -fsSL         --retry 3         --retry-all-errors         -o "$temp_file"         "$(raw_url "$repo_path")" ||
        die "Failed downloading: $repo_path"

    local downloaded_sha
    downloaded_sha="$(git hash-object "$temp_file")"

    if [[ "$downloaded_sha" != "$remote_sha" ]]; then
        warn "Raw download hash mismatch for $repo_path; retrying from GitHub blob API..."

        local blob_json blob_encoding blob_content
        blob_json="$WORKDIR/blob.json"
        curl -fsSL --retry 3 --retry-all-errors             -H "Accept: application/vnd.github+json"             -H "X-GitHub-Api-Version: 2022-11-28"             "https://api.github.com/repos/$GITHUB_OWNER/$GITHUB_REPO/git/blobs/$remote_sha"             > "$blob_json" ||
            die "Failed retrieving GitHub blob: $repo_path"

        blob_encoding="$(jq -r '.encoding // empty' "$blob_json")"
        blob_content="$(jq -r '.content // empty' "$blob_json")"

        [[ "$blob_encoding" == "base64" && -n "$blob_content" ]] ||
            die "GitHub returned an invalid blob for: $repo_path"

        printf '%s' "$blob_content" | tr -d '\n' | base64 -d > "$temp_file" ||
            die "Failed decoding GitHub blob: $repo_path"

        downloaded_sha="$(git hash-object "$temp_file")"
    fi

    if [[ "$downloaded_sha" != "$remote_sha" ]]; then
        if [[ "$FORCE_MODE" == "1" ]]; then
            warn "Blob verification failed for $repo_path; --force will install the downloaded repository file anyway."
        else
            warn "Unable to verify $repo_path; skipping file and continuing."
            ((SKIPPED_COUNT+=1))
            return 0
        fi
    fi

    if [[ "$DRY_RUN" == "1" ]]; then
        printf 'UPDATE %s\n' "$local_path"
        return
    fi

    if ! create_backup "$local_path"; then
        ((SKIPPED_COUNT+=1))
        return 0
    fi

    local install_mode=0644
    if [[ -e "$local_path" && ! -L "$local_path" ]]; then
        install_mode="$(stat -c '%a' "$local_path")"
    else
        case "$local_path" in
            /usr/bin/*|/usr/local/bin/*|/usr/lib/systemd/system-generators/*|/usr/lib/udev/*)
                install_mode=0755
                ;;
        esac
    fi

    install -D -m "$install_mode" "$temp_file" "$local_path"
}

sync_repository() {
    local tree_file="$WORKDIR/tree.json"
    local manifest="$WORKDIR/manifest"
    local deferred_mupdate_path=""
    local deferred_mupdate_mode=""
    local deferred_mupdate_sha=""
    local self_updated=0

    info "Checking MuliOS-Arch..."
    get_tree > "$tree_file" ||
        die "Unable to read the MuliOS-Arch repository."

    jq -e '.tree | type == "array"' "$tree_file" >/dev/null ||
        die "GitHub returned an invalid repository tree."

    [[ "$(jq -r '.truncated // false' "$tree_file")" == "false" ]] ||
        die "GitHub returned a truncated tree; refusing an incomplete merge."

    REMOTE_TREE_SHA="$(jq -r '.sha' "$tree_file")"

    REMOTE_VERSION="$(curl -fsSL --retry 3 --retry-all-errors         "$(raw_url profile/version)")" ||
        die "Unable to read profile/version."

    REMOTE_VERSION="$(printf '%s' "$REMOTE_VERSION" | tr -d '\r\n')"

    info "Remote version: $REMOTE_VERSION"
    info "Remote tree: $REMOTE_TREE_SHA"

    : > "$manifest"

    while IFS="$(printf '\t')" read -r path mode type sha; do
        [[ "$type" == "blob" ]] || continue
        is_syncable "$path" || {
            ((SKIPPED_COUNT+=1))
            continue
        }

        printf '%s\t%s\t%s\n' "$path" "$mode" "$sha" >> "$manifest"
    done < <(
        jq -r '.tree[] | [.path,.mode,.type,.sha] | @tsv' "$tree_file"
    )

    while IFS="$(printf '\t')" read -r path mode remote_sha; do
        local_sha=""

        if local_sha="$(local_blob_sha "$path" "$mode" 2>/dev/null)"; then
            [[ "$local_sha" == "$remote_sha" ]] && continue
            ((CHANGED_COUNT+=1))
            printf 'CHANGED  /%s\n' "$(printf '%s' "$path" | sed 's#^profile/airootfs/##')"
        else
            ((ADDED_COUNT+=1))
            printf 'ADDED    /%s\n' "$(printf '%s' "$path" | sed 's#^profile/airootfs/##')"
        fi

        [[ "$SAFE_MODE" == "1" ]] && continue

        if [[ "$path" == "profile/airootfs/usr/local/bin/mupdate" ]]; then
            deferred_mupdate_path="$path"
            deferred_mupdate_mode="$mode"
            deferred_mupdate_sha="$remote_sha"
            continue
        fi

        if ! confirm "Merge /$(printf '%s' "$path" | sed 's#^profile/airootfs/##')?"; then
            ((SKIPPED_COUNT+=1))
            continue
        fi

        if ! merge_file "$path" "$mode" "$remote_sha"; then
            warn "Skipping /$(printf '%s' "$path" | sed 's#^profile/airootfs/##') and continuing."
            ((SKIPPED_COUNT+=1))
        fi
    done < "$manifest"

    if [[ -n "$deferred_mupdate_path" ]]; then
        if [[ "$SAFE_MODE" == "0" ]]; then
            local current_mupdate_sha=""
            current_mupdate_sha="$(local_blob_sha "$deferred_mupdate_path" "$deferred_mupdate_mode" 2>/dev/null || true)"

            if [[ "$current_mupdate_sha" != "$deferred_mupdate_sha" ]]; then
                merge_file "$deferred_mupdate_path" "$deferred_mupdate_mode" "$deferred_mupdate_sha"
                self_updated=1
            fi
        else
            echo "UPDATE /usr/local/bin/mupdate (deferred until other files are checked)"
        fi
    fi

    if [[ "$self_updated" == "1" && "$SAFE_MODE" == "0" && "$DRY_RUN" == "0" ]]; then
        info "MUpdate itself was updated; restarting with the new version..."
        if [[ "$BETA_MODE" == "1" ]]; then
            exec /usr/local/bin/mupdate update beta
        else
            exec /usr/local/bin/mupdate update
        fi
    fi

    if [[ "$DRY_RUN" == "0" && "$SAFE_MODE" == "0" ]]; then
        mkdir -p "$STATE_DIR"
        printf '%s\n' "$REMOTE_TREE_SHA" > "$STATE_DIR/tree"
        printf '%s\n' "$REMOTE_VERSION" > "$STATE_DIR/version"
        printf '%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$STATE_DIR/last-sync"
        sync
    fi

    echo
    ok "Repository comparison complete."
    echo "Changed : $CHANGED_COUNT"
    echo "Added   : $ADDED_COUNT"
    echo "Skipped : $SKIPPED_COUNT"
}




profile_name_from_path() {
    local path="$1"
    local remainder="\${path#"$PROFILE_ROOT"/}"
    printf '%s' "\${remainder%%/*}"
}

profile_zip_is_direct_child() {
    local path="$1"
    local profile="$2"
    local remainder="\${path#"$PROFILE_ROOT/$profile"/}"

    [[ "$remainder" != "$path" ]] || return 1
    [[ "$remainder" == *.zip ]] || return 1
    [[ "$remainder" != */* ]] || return 1
}

download_verified_profile_zip() {
    local path="$1"
    local expected_sha="$2"
    local destination="$3"
    local raw="$WORKDIR/profile.raw"
    local blob_json="$WORKDIR/profile-blob.json"

    info "Downloading profile package: \$(basename "$path")"

    curl -fsSL --retry 3 --retry-all-errors \
        -o "$raw" \
        "https://raw.githubusercontent.com/$UPDATE_OWNER/$UPDATE_REPO/$UPDATE_BRANCH/$path" ||
        die "Failed to download profile package: $path"

    local actual_sha
    actual_sha="\$(git hash-object "$raw")"

    if [[ "$actual_sha" != "$expected_sha" ]]; then
        warn "Raw profile download hash mismatch; retrieving the Git blob..."

        curl -fsSL --retry 3 --retry-all-errors \
            -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            "https://api.github.com/repos/$UPDATE_OWNER/$UPDATE_REPO/git/blobs/$expected_sha" \
            > "$blob_json" ||
            die "Failed retrieving profile Git blob: $path"

        [[ "\$(jq -r '.encoding // empty' "$blob_json")" == "base64" ]] ||
            die "GitHub returned an unsupported blob encoding for $path"

        jq -r '.content // empty' "$blob_json" |
            tr -d '\\n' |
            base64 -d > "$raw" ||
            die "Failed decoding profile Git blob: $path"

        actual_sha="\$(git hash-object "$raw")"
    fi

    [[ "$actual_sha" == "$expected_sha" ]] ||
        die "Profile package verification failed: $path"

    mv "$raw" "$destination"
    ok "Verified profile package: \$(basename "$path")"
}

validate_profile_archive() {
    local archive="$1"
    local extract_dir="$2"

    info "Validating profile archive..."

    unzip -tq "$archive" ||
        die "Profile archive is corrupt: \$(basename "$archive")"

    rm -rf "$extract_dir"
    mkdir -p "$extract_dir"
    unzip -q "$archive" -d "$extract_dir" ||
        die "Failed to extract profile archive."

    [[ -f "$extract_dir/sh/install.sh" ]] ||
        die "Profile archive is missing sh/install.sh"

    [[ -f "$extract_dir/sh/packages.sh" ]] ||
        die "Profile archive is missing sh/packages.sh"

    chmod +x "$extract_dir/sh/install.sh" "$extract_dir/sh/packages.sh"

    bash -n "$extract_dir/sh/install.sh" ||
        die "Profile sh/install.sh failed shell syntax validation."

    bash -n "$extract_dir/sh/packages.sh" ||
        die "Profile sh/packages.sh failed shell syntax validation."

    local package_count
    package_count="\$(find "$extract_dir" -maxdepth 1 -type f \
        \( -name '*.pkg.tar.zst' -o -name '*.pkg.tar.xz' -o -name '*.pkg.tar.gz' \) |
        wc -l)"

    [[ "$package_count" -gt 0 ]] ||
        die "Profile archive contains no Arch package files."

    info "Profile archive is valid."
    echo "    install script : sh/install.sh"
    echo "    package script : sh/packages.sh"
    echo "    package files  : $package_count"
}

cmd_profile() {
    require_root
    require_cmd curl jq git sha1sum sha256sum unzip mktemp mkdir rm mv cp chmod find sort wc
    verify_os
    acquire_lock

    local tree_file="$WORKDIR/update-tree.json"
    local manifest="$WORKDIR/profiles.tsv"

    info "Checking MuliOS profile repository..."
    curl -fsSL --retry 3 --retry-all-errors \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "https://api.github.com/repos/$UPDATE_OWNER/$UPDATE_REPO/git/trees/$UPDATE_BRANCH?recursive=1" \
        > "$tree_file" ||
        die "Unable to read the MuliOS update repository."

    jq -e '.tree | type == "array"' "$tree_file" >/dev/null ||
        die "GitHub returned an invalid profile repository tree."

    [[ "\$(jq -r '.truncated // false' "$tree_file")" == "false" ]] ||
        die "GitHub returned a truncated profile tree; refusing an incomplete profile list."

    info "Profile tree verified: \$(jq -r '.sha' "$tree_file")"
    : > "$manifest"

    # Only a ZIP directly inside profiles/<name>/ qualifies.
    # Anything deeper, including profiles/<name>/old/, is ignored.
    while IFS="\$(printf '\\t')" read -r path mode type sha; do
        [[ "$type" == "blob" ]] || continue
        [[ "$path" == profiles/* ]] || continue

        local remainder="\${path#profiles/}"
        local profile="\${remainder%%/*}"
        [[ -n "$profile" ]] || continue
        local inside="\${path#profiles/$profile/}"

        [[ "$inside" != "$path" ]] || continue
        [[ "$inside" == *.zip ]] || continue
        [[ "$inside" != */* ]] || continue

        printf '%s\\t%s\\t%s\\n' "$profile" "$path" "$sha" >> "$manifest"
    done < <(jq -r '.tree[] | [.path,.mode,.type,.sha] | @tsv' "$tree_file")

    [[ -s "$manifest" ]] || die "No installable MuliOS profiles were found."

    mapfile -t PROFILE_ROWS < "$manifest"

    echo
    info "Available MuliOS profiles:"
    echo

    local i=1 row profile path sha
    for row in "\${PROFILE_ROWS[@]}"; do
        IFS="\$(printf '\\t')" read -r profile path sha <<< "$row"
        printf '  %d: %s\\n' "$i" "$profile"
        ((i+=1))
    done

    echo
    local choice
    while true; do
        read -r -p "Select a profile [1-\${#PROFILE_ROWS[@]}]: " choice
        [[ "$choice" =~ ^[0-9]+$ ]] || { warn "Enter a number."; continue; }
        (( choice >= 1 && choice <= \${#PROFILE_ROWS[@]} )) || { warn "Invalid profile selection."; continue; }
        break
    done

    row="\${PROFILE_ROWS[\$((choice-1))]}"
    IFS="\$(printf '\\t')" read -r profile path sha <<< "$row"

    echo
    info "Selected profile: $profile"
    info "Package: \$(basename "$path")"

    local archive="$WORKDIR/$profile.zip"
    local extract_dir="$WORKDIR/$profile"

    download_verified_profile_zip "$path" "$sha" "$archive"
    validate_profile_archive "$archive" "$extract_dir"

    echo
    warn "sh/install.sh will always run before sh/packages.sh."
    echo

    if ! confirm "Install the $profile profile?"; then
        warn "Profile installation cancelled."
        return 0
    fi

    info "Running sh/install.sh first..."
    ( cd "$extract_dir" && ./sh/install.sh ) ||
        die "Profile kernel/image installation failed."
    ok "sh/install.sh completed."

    info "Running sh/packages.sh second..."
    ( cd "$extract_dir" && ./sh/packages.sh ) ||
        die "Profile package installation failed."
    ok "sh/packages.sh completed."

    mkdir -p "$STATE_DIR/profiles"
    printf '%s\\n' "$profile" > "$STATE_DIR/profiles/active"
    printf '%s\\n' "$sha" > "$STATE_DIR/profiles/$profile.sha"
    printf '%s\\n' "\$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$STATE_DIR/profiles/last-install"

    echo
    ok "MuliOS $profile profile installation complete."
    warn "Reboot if the profile installed a new kernel."
}

sync_rounded_theme() {
    local installer_script="$WORKDIR/install-rounded-theme.sh"
    local commit
    if ! curl -fsSL --retry 3 --retry-all-errors -o "$installer_script" "$(raw_url scripts/install-rounded-theme.sh)"; then
        warn "Unable to read the pinned ROUNDED theme version; skipping ROUNDED theme update."
        return 0
    fi

    commit="$(sed -n 's/^THEME_COMMIT="\([^"]*\)"/\1/p' "$installer_script" | head -n 1)"
    if [[ ! "$commit" =~ ^[0-9a-f]{40}$ ]]; then
        warn "Invalid ROUNDED theme commit; skipping ROUNDED theme update."
        return 0
    fi

    local state_file="$STATE_DIR/rounded-theme-commit"
    if [[ -f "$state_file" && "$(cat "$state_file")" == "$commit" &&
          -d /usr/share/plasma/desktoptheme/ROUNDED-DARK &&
          -d /usr/share/plasma/look-and-feel/com.github.varlesh.rounded-dark &&
          -d /usr/share/aurorae/themes/ROUNDED-DARK &&
          -f /usr/share/color-schemes/ROUNDEDDARK.colors ]]; then
        info "ROUNDED theme already matches pinned commit $commit."
        return 0
    fi

    if [[ "$DRY_RUN" == "1" || "$SAFE_MODE" == "1" ]]; then
        echo "THEME   ROUNDED-DARK @ $commit"
        return 0
    fi

    info "Downloading pinned ROUNDED KDE theme $commit..."
    local archive="$WORKDIR/rounded.tar.gz"
    if ! curl -fsSL --retry 3 --retry-all-errors -o "$archive" "https://github.com/varlesh/rounded/archive/$commit.tar.gz"; then
        warn "Unable to download the ROUNDED theme archive; skipping."
        return 0
    fi
    if ! tar -xzf "$archive" -C "$WORKDIR"; then
        warn "Unable to extract the ROUNDED theme archive; skipping."
        return 0
    fi

    local root="$WORKDIR/rounded-$commit"
    if [[ ! -d "$root/plasma/desktoptheme/ROUNDED-DARK" ]]; then
        warn "ROUNDED desktop theme is missing from archive; skipping."
        return 0
    fi
    if [[ ! -d "$root/plasma/look-and-feel/com.github.varlesh.rounded-dark" ]]; then
        warn "ROUNDED Look-and-Feel package is missing from archive; skipping."
        return 0
    fi
    if [[ ! -d "$root/aurorae/themes/ROUNDED-DARK" ]]; then
        warn "ROUNDED Aurorae decoration is missing from archive; skipping."
        return 0
    fi
    if [[ ! -f "$root/plasma/desktoptheme/ROUNDED-DARK/colors" ]]; then
        warn "ROUNDED color scheme is missing from archive; skipping."
        return 0
    fi

    install -d /usr/share/plasma/desktoptheme /usr/share/plasma/look-and-feel /usr/share/aurorae/themes /usr/share/color-schemes
    cp -a "$root/plasma/desktoptheme/ROUNDED-DARK" /usr/share/plasma/desktoptheme/
    cp -a "$root/plasma/look-and-feel/com.github.varlesh.rounded-dark" /usr/share/plasma/look-and-feel/
    cp -a "$root/aurorae/themes/ROUNDED-DARK" /usr/share/aurorae/themes/
    install -m 0644 "$root/plasma/desktoptheme/ROUNDED-DARK/colors" /usr/share/color-schemes/ROUNDEDDARK.colors
    printf "%s\n" "$commit" > "$state_file"
    ok "ROUNDED theme merged at pinned commit $commit."
}

cmd_update() {
    require_root
    check_dependencies
    verify_os

    if [[ "$BETA_MODE" == "1" ]]; then
        local os_version=""
        os_version="$(sed -n 's/^VERSION_ID=//p' /etc/os-release | tr -d '"')"
        [[ "$os_version" == *C ]] || {
            err "unable to fetch from beta: your version is not a canary build."
            exit 1
        }
        GITHUB_BRANCH="beta"
        info "MUpdate $VERSION — direct repository merge (beta/canary)"
    else
        GITHUB_BRANCH="main"
        info "MUpdate $VERSION — direct repository merge"
    fi

    acquire_lock

    if [[ "$DRY_RUN" == "1" ]]; then
        warn "Dry-run: no files will be changed."
    elif [[ "$SAFE_MODE" == "1" ]]; then
        warn "Safe mode: changes will be listed but not applied."
    fi

    sync_repository
    sync_rounded_theme

    if [[ "$DRY_RUN" == "0" && "$SAFE_MODE" == "0" ]]; then
        ok "MuliOS repository changes merged into the installed OS."
    fi
}

cmd_status() {
    echo "MUpdate $VERSION"
    echo "Repository: https://github.com/$GITHUB_OWNER/$GITHUB_REPO"
    echo "Branch: $GITHUB_BRANCH"

    [[ -f "$STATE_DIR/version" ]] &&
        echo "Last synced version: $(cat "$STATE_DIR/version")"

    [[ -f "$STATE_DIR/tree" ]] &&
        echo "Last synced tree: $(cat "$STATE_DIR/tree")"

    [[ -f "$STATE_DIR/last-sync" ]] &&
        echo "Last sync: $(cat "$STATE_DIR/last-sync")"
}

show_help() {
    cat <<EOF
MUpdate $VERSION — MuliOS repository merger

UPDATE
  sudo mupdate update
  sudo mupdate sync
  sudo mupdate update -y

BETA / CANARY
  sudo mupdate update beta

  Beta updates target only:
    https://github.com/MuliOS-dev/MuliOS-Arch/tree/beta

  Beta updates are available only on Canary builds (C suffix).
  Otherwise MUpdate aborts with:
    unable to fetch from beta: your version is not a canary build.

PROFILE
  sudo mupdate profile

  Profiles are discovered from the complete recursive Git tree of:
    https://github.com/MuliOS-dev/update/tree/main/profiles

  Only a ZIP directly inside profiles/<name>/ is listed.
  Nested files such as profiles/gaming/old/... are ignored.

  The selected ZIP is verified against its Git blob SHA and tested before
  installation.

  Installation order:
    1. sh/install.sh
    2. sh/packages.sh

  sh/install.sh is responsible for installing kernel packages and must install
  kernel headers before kernel/image packages.

CHECK
  sudo mupdate update --dry-run
  sudo mupdate update --safe
  sudo mupdate update --force
  mupdate status

SOURCE
  https://github.com/$GITHUB_OWNER/$GITHUB_REPO
  branch: $GITHUB_BRANCH
  filesystem tree: profile/airootfs

BEHAVIOR
  The repository is compared directly with the installed filesystem.

  profile/airootfs/etc/foo
      -> /etc/foo

  profile/airootfs/usr/bin/foo
      -> /usr/bin/foo

  New or changed files are downloaded and merged.

  Before an existing system file is overwritten, MUpdate creates a ZIP backup
  under /var/lib/mupdate/backups/. Backups contain the original filesystem
  path and are timestamped per overwritten file.

  Files are never deleted.

  Normal updates skip files that cannot be verified or merged and continue.
  Use --force to overwrite a file when repository blob verification fails.
  New files default to non-executable permissions unless installed under a
  known executable directory. Existing file permissions are preserved.

  Live-ISO-only files are excluded, including live-user autologin, the live
  installer shortcut, live systemd unit links, and archiso mkinitcpio config.

PROTECTED MACHINE STATE
  /etc/passwd
  /etc/shadow
  /etc/group
  /etc/gshadow
  /etc/hostname
  /etc/hosts
  /etc/machine-id
  /etc/localtime
  /etc/adjtime
  /etc/fstab
  /etc/crypttab
  /etc/ssh/
  /var/
  /home/
  /root/
  /boot/
  /efi/
EOF
}

main() {
    local command="update"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            update|sync)
                command="update"
                if [[ "${2:-}" == "beta" ]]; then
                    BETA_MODE=1
                    shift
                fi
                ;;
            profile)
                command="profile"
                ;;
            status)
                command="status"
                ;;
            -y|--yes)
                ASSUME_YES=1
                ;;
            --safe|-s)
                SAFE_MODE=1
                ;;
            --dry-run)
                DRY_RUN=1
                ;;
            --force|-f)
                FORCE_MODE=1
                ;;
            --version|-v)
                echo "mupdate version $VERSION"
                exit 0
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                die "Unknown argument: $1"
                ;;
        esac
        shift
    done

    case "$command" in
        update) cmd_update ;;
        profile) cmd_profile ;;
        status) cmd_status ;;
    esac
}

main "$@"
