#!/usr/bin/env bash
set -Eeuo pipefail

# MUpdate
# Version: a1.0.7
#
# Source: https://github.com/MuliOS-dev/MuliOS-Arch
# Source tree: profile/airootfs
#
# Only new/changed MuliOS-owned files are downloaded.
# Files are never deleted as of now.
# Machine-specific state is protected.

VERSION="a1.0.7"
GITHUB_OWNER="MuliOS-dev"
GITHUB_REPO="MuliOS-Arch"
GITHUB_BRANCH="main"

STATE_DIR="/var/lib/mupdate"
LOG_FILE="/var/log/mupdate.log"
LOCK_FILE="$STATE_DIR/mupdate.lock"
WORKDIR="$(mktemp -d /tmp/mupdate.XXXXXX)"

ASSUME_YES=1
SAFE_MODE=0
DRY_RUN=0

CHANGED_COUNT=0
ADDED_COUNT=0
SKIPPED_COUNT=0
REMOTE_VERSION=""
REMOTE_TREE_SHA=""

cleanup() {
    rm -rf "$WORKDIR"
}
trap cleanup EXIT
trap 'die "Interrupted."' INT TERM

log() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    printf '%s [MUpdate] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" >> "$LOG_FILE" 2>/dev/null || true
}

info() {
    printf '\033[0;34m==>\033[0m %s\n' "$*" >&2
    log "INFO: $*"
}

ok() {
    printf '\033[0;32m==>\033[0m %s\n' "$*" >&2
    log "OK: $*"
}

warn() {
    printf '\033[0;33m==>\033[0m %s\n' "$*" >&2
    log "WARN: $*"
}

err() {
    printf '\033[0;31m==>\033[0m %s\n' "$*" >&2
    log "ERROR: $*"
}

die() {
    err "$*"
    exit 1
}

require_root() {
    [[ "$(id -u)" -eq 0 ]] || die "Run MUpdate with sudo."
}

require_cmd() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "Missing required command: $cmd"
    done
}

check_dependencies() {
    require_cmd curl jq git sha1sum sha256sum install mkdir rm mktemp stat chmod readlink flock tar cp sed tr date head cat
}

acquire_lock() {
    mkdir -p "$STATE_DIR"
    exec 200>"$LOCK_FILE"
    flock -n 200 || die "Another MUpdate process is already running."
}

verify_os() {
    [[ -r /etc/os-release ]] || die "/etc/os-release is missing."

    local id id_like
    id="$(sed -n 's/^ID=//p' /etc/os-release | tr -d '"')"
    id_like="$(sed -n 's/^ID_LIKE=//p' /etc/os-release | tr -d '"')"

    [[ "$id" == "mulios" && "$id_like" == *arch* ]] ||
        die "This is not an Arch-based MuliOS installation."
}

raw_url() {
    printf 'https://raw.githubusercontent.com/%s/%s/%s/%s\n' \
        "$GITHUB_OWNER" "$GITHUB_REPO" "$GITHUB_BRANCH" "$1"
}

get_tree() {
    curl -fsSL         --retry 3         --retry-all-errors         -H "Accept: application/vnd.github+json"         -H "X-GitHub-Api-Version: 2022-11-28"         "https://api.github.com/repos/$GITHUB_OWNER/$GITHUB_REPO/git/trees/$GITHUB_BRANCH?recursive=1"
}

is_protected() {
    local path="$1"
    case "$path" in
        profile/airootfs/etc/passwd|profile/airootfs/etc/shadow|profile/airootfs/etc/group|profile/airootfs/etc/gshadow|profile/airootfs/etc/hostname|profile/airootfs/etc/hosts|profile/airootfs/etc/machine-id|profile/airootfs/etc/localtime|profile/airootfs/etc/adjtime|profile/airootfs/etc/fstab|profile/airootfs/etc/crypttab|profile/airootfs/etc/ssh/*|profile/airootfs/etc/sddm.conf.d/autologin.conf|profile/airootfs/etc/sudoers.d/mulios-installer|profile/airootfs/etc/systemd/system/*|profile/airootfs/etc/mkinitcpio.conf.d/archiso.conf|profile/airootfs/etc/systemd/resolved.conf.d/archiso.conf|profile/airootfs/etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook|profile/airootfs/etc/pacman.d/hooks/uncomment-mirrors.hook|profile/airootfs/usr/local/bin/livecd-sound|profile/airootfs/usr/share/applications/mulios-installer.desktop|profile/airootfs/usr/share/applications/mulios-changelog.desktop|profile/airootfs/etc/xdg/autostart/mulios-welcome.desktop|profile/airootfs/etc/skel/Desktop/mulios-installer.desktop|profile/airootfs/opt/mulios-installer/*|profile/airootfs/opt/mulios-changelog/*|profile/airootfs/var/*|profile/airootfs/home/*|profile/airootfs/root/*|profile/airootfs/boot/*|profile/airootfs/efi/*)
            return 0
            ;;
    esac
    return 1
}

is_syncable() {
    [[ "$1" == profile/airootfs/* ]] || return 1
    is_protected "$1" && return 1
    return 0
}

local_blob_sha() {
    local repo_path="$1"
    local mode="$2"
    local local_path

    local_path="$(printf '%s' "$repo_path" | sed 's#^profile/airootfs##')"

    if [[ "$mode" == "120000" ]]; then
        [[ -L "$local_path" ]] || return 1
        local link_target
        link_target="$(readlink "$local_path")"
        printf '%s' "$link_target" | git hash-object --stdin
        return
    fi

    [[ -f "$local_path" ]] || return 1
    git hash-object "$local_path"
}

confirm() {
    [[ "$ASSUME_YES" == "1" ]] && return 0

    local reply
    read -r -p "? $1 [y/N] " reply

    case "$reply" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

merge_file() {
    local repo_path="$1"
    local mode="$2"
    local remote_sha="$3"
    local local_path

    local_path="$(printf '%s' "$repo_path" | sed 's#^profile/airootfs##')"

    if [[ "$mode" == "120000" ]]; then
        local link_target
        link_target="$(curl -fsSL --retry 3 --retry-all-errors "$(raw_url "$repo_path")")" ||
            die "Failed downloading symlink: $repo_path"

        local link_sha
        link_sha="$(printf '%s' "$link_target" | git hash-object --stdin)"
        [[ "$link_sha" == "$remote_sha" ]] || die "Repository changed while downloading symlink: $repo_path"

        if [[ "$DRY_RUN" == "1" ]]; then
            printf 'UPDATE LINK %s -> %s\n' "$local_path" "$link_target"
            return
        fi

        rm -f "$local_path"
        mkdir -p "$(dirname "$local_path")"
        ln -s "$link_target" "$local_path"
        return
    fi

    local temp_file="$WORKDIR/file"
    curl -fsSL         --retry 3         --retry-all-errors         -o "$temp_file"         "$(raw_url "$repo_path")" ||
        die "Failed downloading: $repo_path"

    local downloaded_sha
    downloaded_sha="$(git hash-object "$temp_file")"
    [[ "$downloaded_sha" == "$remote_sha" ]] ||
        die "Repository changed or download was corrupted: $repo_path"

    if [[ "$DRY_RUN" == "1" ]]; then
        printf 'UPDATE %s\n' "$local_path"
        return
    fi

    local install_mode=0644
    if [[ -e "$local_path" && ! -L "$local_path" ]]; then
        install_mode="$(stat -c '%a' "$local_path")"
    else
        case "$local_path" in
            /usr/bin/*|/usr/local/bin/*|/usr/lib/systemd/system-generators/*|/usr/lib/udev/*)
                install_mode=0755
                ;;
        esac
    fi

    install -D -m "$install_mode" "$temp_file" "$local_path"
}

sync_repository() {
    local tree_file="$WORKDIR/tree.json"
    local manifest="$WORKDIR/manifest"
    local deferred_mupdate_path=""
    local deferred_mupdate_mode=""
    local deferred_mupdate_sha=""

    info "Checking MuliOS-Arch..."
    get_tree > "$tree_file" ||
        die "Unable to read the MuliOS-Arch repository."

    jq -e '.tree | type == "array"' "$tree_file" >/dev/null ||
        die "GitHub returned an invalid repository tree."

    [[ "$(jq -r '.truncated // false' "$tree_file")" == "false" ]] ||
        die "GitHub returned a truncated tree; refusing an incomplete merge."

    REMOTE_TREE_SHA="$(jq -r '.sha' "$tree_file")"

    REMOTE_VERSION="$(curl -fsSL --retry 3 --retry-all-errors         "$(raw_url profile/version)")" ||
        die "Unable to read profile/version."

    REMOTE_VERSION="$(printf '%s' "$REMOTE_VERSION" | tr -d '\r\n')"

    info "Remote version: $REMOTE_VERSION"
    info "Remote tree: $REMOTE_TREE_SHA"

    : > "$manifest"

    while IFS="$(printf '\t')" read -r path mode type sha; do
        [[ "$type" == "blob" ]] || continue
        is_syncable "$path" || {
            ((SKIPPED_COUNT+=1))
            continue
        }

        printf '%s\t%s\t%s\n' "$path" "$mode" "$sha" >> "$manifest"
    done < <(
        jq -r '.tree[] | [.path,.mode,.type,.sha] | @tsv' "$tree_file"
    )

    while IFS="$(printf '\t')" read -r path mode remote_sha; do
        local_sha=""

        if local_sha="$(local_blob_sha "$path" "$mode" 2>/dev/null)"; then
            [[ "$local_sha" == "$remote_sha" ]] && continue
            ((CHANGED_COUNT+=1))
            printf 'CHANGED  /%s\n' "$(printf '%s' "$path" | sed 's#^profile/airootfs/##')"
        else
            ((ADDED_COUNT+=1))
            printf 'ADDED    /%s\n' "$(printf '%s' "$path" | sed 's#^profile/airootfs/##')"
        fi

        [[ "$SAFE_MODE" == "1" ]] && continue

        if [[ "$path" == "profile/airootfs/usr/local/bin/mupdate" ]]; then
            deferred_mupdate_path="$path"
            deferred_mupdate_mode="$mode"
            deferred_mupdate_sha="$remote_sha"
            continue
        fi

        if ! confirm "Merge /$(printf '%s' "$path" | sed 's#^profile/airootfs/##')?"; then
            ((SKIPPED_COUNT+=1))
            continue
        fi

        merge_file "$path" "$mode" "$remote_sha"
    done < "$manifest"

    if [[ -n "$deferred_mupdate_path" ]]; then
        if [[ "$SAFE_MODE" == "0" ]]; then
            merge_file "$deferred_mupdate_path" "$deferred_mupdate_mode" "$deferred_mupdate_sha"
        else
            echo "UPDATE /usr/local/bin/mupdate (deferred until other files are checked)"
        fi
    fi

    if [[ "$DRY_RUN" == "0" && "$SAFE_MODE" == "0" ]]; then
        mkdir -p "$STATE_DIR"
        printf '%s\n' "$REMOTE_TREE_SHA" > "$STATE_DIR/tree"
        printf '%s\n' "$REMOTE_VERSION" > "$STATE_DIR/version"
        printf '%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" > "$STATE_DIR/last-sync"
        sync
    fi

    echo
    ok "Repository comparison complete."
    echo "Changed : $CHANGED_COUNT"
    echo "Added   : $ADDED_COUNT"
    echo "Skipped : $SKIPPED_COUNT"
}


fix_fastfetch() {
    local config="/etc/fastfetch/config.jsonc"
    [[ -f "$config" ]] || {
        warn "MuliOS Fastfetch configuration is missing; skipping Fastfetch migration."
        return 0
    }

    info "Applying canonical MuliOS Fastfetch configuration..."

    # MUpdate protects /home from repository replacement because it contains
    # machine/user state. Fastfetch defaults are an intentional exception:
    # remove obsolete per-user configs so old output cannot override MuliOS.
    if [[ -d /home ]]; then
        while IFS= read -r -d '' home_dir; do
            local user_name
            user_name="$(basename "$home_dir")"
            [[ "$user_name" == "lost+found" ]] && continue

            install -d -m 0755 "$home_dir/.config/fastfetch"
            install -m 0644 "$config" "$home_dir/.config/fastfetch/config.jsonc"
            rm -f \
                "$home_dir/.config/fastfetch/config.conf" \
                "$home_dir/.config/fastfetch/config.json"

            if id "$user_name" >/dev/null 2>&1; then
                chown -R "$user_name:$user_name" "$home_dir/.config/fastfetch" 2>/dev/null || true
            fi
        done < <(find /home -mindepth 1 -maxdepth 1 -type d -print0)
    fi

    # Root is not covered by the /home migration above.
    install -d -m 0755 /root/.config/fastfetch
    install -m 0644 "$config" /root/.config/fastfetch/config.jsonc
    rm -f /root/.config/fastfetch/config.conf /root/.config/fastfetch/config.json

    if [[ -f /usr/local/bin/fastfetch ]]; then
        chmod 0755 /usr/local/bin/fastfetch
    fi

    ok "Canonical MuliOS Fastfetch configuration applied."
}

sync_rounded_theme() {
    local installer_script="$WORKDIR/install-rounded-theme.sh"
    local commit
    curl -fsSL --retry 3 --retry-all-errors -o "$installer_script" "$(raw_url scripts/install-rounded-theme.sh)" ||
        die "Unable to read the pinned ROUNDED theme version from the repository."

    commit="$(sed -n 's/^THEME_COMMIT="\([^"]*\)"/\1/p' "$installer_script" | head -n 1)"
    [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "Invalid ROUNDED theme commit in scripts/install-rounded-theme.sh."

    local state_file="$STATE_DIR/rounded-theme-commit"
    if [[ -f "$state_file" && "$(cat "$state_file")" == "$commit" &&
          -d /usr/share/plasma/desktoptheme/ROUNDED-DARK &&
          -d /usr/share/plasma/look-and-feel/com.github.varlesh.rounded-dark &&
          -d /usr/share/aurorae/themes/ROUNDED-DARK &&
          -f /usr/share/color-schemes/ROUNDEDDARK.colors ]]; then
        info "ROUNDED theme already matches pinned commit $commit."
        return 0
    fi

    if [[ "$DRY_RUN" == "1" || "$SAFE_MODE" == "1" ]]; then
        echo "THEME   ROUNDED-DARK @ $commit"
        return 0
    fi

    info "Downloading pinned ROUNDED KDE theme $commit..."
    local archive="$WORKDIR/rounded.tar.gz"
    curl -fsSL --retry 3 --retry-all-errors -o "$archive" "https://github.com/varlesh/rounded/archive/$commit.tar.gz" ||
        die "Unable to download the ROUNDED theme archive."
    tar -xzf "$archive" -C "$WORKDIR" || die "Unable to extract the ROUNDED theme archive."

    local root="$WORKDIR/rounded-$commit"
    [[ -d "$root/plasma/desktoptheme/ROUNDED-DARK" ]] || die "ROUNDED desktop theme is missing from archive."
    [[ -d "$root/plasma/look-and-feel/com.github.varlesh.rounded-dark" ]] || die "ROUNDED Look-and-Feel package is missing from archive."
    [[ -d "$root/aurorae/themes/ROUNDED-DARK" ]] || die "ROUNDED Aurorae decoration is missing from archive."
    [[ -f "$root/plasma/desktoptheme/ROUNDED-DARK/colors" ]] || die "ROUNDED color scheme is missing from archive."

    install -d /usr/share/plasma/desktoptheme /usr/share/plasma/look-and-feel /usr/share/aurorae/themes /usr/share/color-schemes
    cp -a "$root/plasma/desktoptheme/ROUNDED-DARK" /usr/share/plasma/desktoptheme/
    cp -a "$root/plasma/look-and-feel/com.github.varlesh.rounded-dark" /usr/share/plasma/look-and-feel/
    cp -a "$root/aurorae/themes/ROUNDED-DARK" /usr/share/aurorae/themes/
    install -m 0644 "$root/plasma/desktoptheme/ROUNDED-DARK/colors" /usr/share/color-schemes/ROUNDEDDARK.colors
    printf "%s\n" "$commit" > "$state_file"
    ok "ROUNDED theme merged at pinned commit $commit."
}

cmd_update() {
    require_root
    check_dependencies
    verify_os
    acquire_lock

    info "MUpdate $VERSION — direct repository merge"

    if [[ "$DRY_RUN" == "1" ]]; then
        warn "Dry-run: no files will be changed."
    elif [[ "$SAFE_MODE" == "1" ]]; then
        warn "Safe mode: changes will be listed but not applied."
    fi

    sync_repository
    fix_fastfetch
    sync_rounded_theme

    if [[ "$DRY_RUN" == "0" && "$SAFE_MODE" == "0" ]]; then
        ok "MuliOS repository changes merged into the installed OS."
    fi
}

cmd_status() {
    echo "MUpdate $VERSION"
    echo "Repository: https://github.com/$GITHUB_OWNER/$GITHUB_REPO"
    echo "Branch: $GITHUB_BRANCH"

    [[ -f "$STATE_DIR/version" ]] &&
        echo "Last synced version: $(cat "$STATE_DIR/version")"

    [[ -f "$STATE_DIR/tree" ]] &&
        echo "Last synced tree: $(cat "$STATE_DIR/tree")"

    [[ -f "$STATE_DIR/last-sync" ]] &&
        echo "Last sync: $(cat "$STATE_DIR/last-sync")"
}

show_help() {
    cat <<EOF
MUpdate $VERSION — MuliOS repository merger

UPDATE
  sudo mupdate update
  sudo mupdate sync
  sudo mupdate update -y

CHECK
  sudo mupdate update --dry-run
  sudo mupdate update --safe
  mupdate status

SOURCE
  https://github.com/$GITHUB_OWNER/$GITHUB_REPO
  branch: $GITHUB_BRANCH
  filesystem tree: profile/airootfs

BEHAVIOR
  The repository is compared directly with the installed filesystem.

  profile/airootfs/etc/foo
      -> /etc/foo

  profile/airootfs/usr/bin/foo
      -> /usr/bin/foo

  New or changed files are downloaded and merged.

  Files are never deleted.
  New files default to non-executable permissions unless installed under a
  known executable directory. Existing file permissions are preserved.

  Live-ISO-only files are excluded, including live-user autologin, the live
  installer shortcut, live systemd unit links, and archiso mkinitcpio config.

PROTECTED MACHINE STATE
  /etc/passwd
  /etc/shadow
  /etc/group
  /etc/gshadow
  /etc/hostname
  /etc/hosts
  /etc/machine-id
  /etc/localtime
  /etc/adjtime
  /etc/fstab
  /etc/crypttab
  /etc/ssh/
  /var/
  /home/
  /root/
  /boot/
  /efi/
EOF
}

main() {
    local command="update"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            update|sync)
                command="update"
                ;;
            status)
                command="status"
                ;;
            -y|--yes)
                ASSUME_YES=1
                ;;
            --safe|-s)
                SAFE_MODE=1
                ;;
            --dry-run)
                DRY_RUN=1
                ;;
            --version|-v)
                echo "mupdate version $VERSION"
                exit 0
                ;;
            --help|-h)
                show_help
                exit 0
                ;;
            *)
                die "Unknown argument: $1"
                ;;
        esac
        shift
    done

    case "$command" in
        update) cmd_update ;;
        status) cmd_status ;;
    esac
}

main "$@"
