#!/usr/bin/env bash
set -u

WALLPAPER="/usr/share/backgrounds/mulios/wallpaper.png"
MARKER="$HOME/.config/.mulios-wallpaper-applied"

[ -f "$WALLPAPER" ] || exit 0

mkdir -p "$(dirname "$MARKER")"

# plasma-apply-wallpaperimage is provided by plasma-workspace and is the
# supported command-line path for changing the current Plasma wallpaper.
# Plasma can take a few seconds to finish starting, so retry for up to 20s.
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
    for _ in $(seq 1 20); do
        if plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null 2>&1; then
            touch "$MARKER"
            exit 0
        fi
        sleep 1
    done
fi

# Fallback for sessions where the helper command is unavailable.
QDBUS=""
if command -v qdbus6 >/dev/null 2>&1; then
    QDBUS="$(command -v qdbus6)"
elif command -v qdbus >/dev/null 2>&1; then
    QDBUS="$(command -v qdbus)"
fi

if [ -n "$QDBUS" ]; then
    SCRIPT='
var desktopsList = desktops();
for (var i = 0; i < desktopsList.length; ++i) {
    var desktop = desktopsList[i];
    desktop.wallpaperPlugin = "org.kde.image";
    desktop.currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
    desktop.writeConfig("Image", "file:///usr/share/backgrounds/mulios/wallpaper.png");
}
'
    for _ in $(seq 1 10); do
        if "$QDBUS" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$SCRIPT" >/dev/null 2>&1; then
            touch "$MARKER"
            exit 0
        fi
        sleep 1
    done
fi

exit 1
