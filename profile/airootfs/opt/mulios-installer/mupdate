#!/usr/bin/env bash

# MUpdate — MuliOS Arch OTA + Kernel Profile Manager
#
# Version: a1.0.5
#
# NOTICE TO USERS:
# MUpdate is a system program that modifies the kernel and bootloader.
# IT IS NOT INTENDED FOR MODIFICATIONS.
# DO NOT INSTALL OR RUN ANY MODIFIED MUPDATE VERSIONS.
#
# Commands:
#
#   sudo mupdate install
#   sudo mupdate <profile>
#   sudo mupdate <profile> -r
#   sudo mupdate <profile> -y
#   sudo mupdate <profile> -s
#   sudo mupdate <profile> -f
#   sudo mupdate <profile> setup
#
# OTA:
#
#   sudo mupdate ota beta
#   sudo mupdate ota stable
#
# Information:
#
#   mupdate --version
#   mupdate --help
#   sudo mupdate status
#   sudo mupdate cancel
#   sudo mupdate --check
#
# OTA transaction:
#
#   1. Discover split ISO
#   2. Download every part
#   3. Verify part continuity
#   4. Reassemble ISO
#   5. Verify ISO 9660 structure
#   6. Calculate ISO SHA-256
#   7. Backup user data
#   8. Create persistent transaction
#   9. Install MuliRecovery boot payload
#  10. Configure one-shot recovery boot
#  11. Reboot into MuliRecovery
#
# MuliRecovery performs the offline OS merge.
#
# The merge is designed to preserve:
#
#   /home
#   /root
#   /etc
#   /var
#   /boot
#   /efi
#   /srv
#   /opt
#
# while allowing the new MuliOS release to update system files.
#
# IMPORTANT:
# The recovery engine is responsible for the actual merge.
# MUpdate never overwrites the live root filesystem while it is running.

set -Eeuo pipefail

VERSION="a1.0.5"

GITHUB_OWNER="${GITHUB_OWNER:-MuliOS-dev}"
GITHUB_REPO="${GITHUB_REPO:-update}"
GITHUB_BRANCH="${GITHUB_BRANCH:-main}"
GITHUB_TOKEN="${GITHUB_TOKEN:-}"

STATE_DIR="/var/lib/mupdate"
PROFILE_STATE_DIR="${STATE_DIR}/state"
TRANS_DIR="${STATE_DIR}/transaction"
BACKUP_DIR="${STATE_DIR}/backups"
CHANNEL_FILE="${STATE_DIR}/channel"
LOG_FILE="/var/log/mupdate.log"
LOCK_FILE="${STATE_DIR}/mupdate.lock"

RECOVERY_STATE_DIR="${STATE_DIR}/recovery"
RECOVERY_ISO_DIR="${RECOVERY_STATE_DIR}/iso"
RECOVERY_ISO_GLOB="${RECOVERY_ISO_GLOB:-${RECOVERY_ISO_DIR}/MuliRecovery-*-x86_64.iso}"

WORKDIR="$(mktemp -d /tmp/mupdate.XXXXXX)"

ASSUME_YES=0
SAFE_MODE=0
FORCE=0
RESET=0

CURRENT_PROFILE=""
KERNEL_VERSION=""
OS_TAG=""

TARGET_PROFILE=""

RUN_HAD_FAILURES=0

PROFILE_DIR=""
ZIP_NAME=""
ZIP_URL=""
CHECKSUM_NAME=""
CHECKSUM_URL=""
ZIP_PATH=""
EXTRACT_DIR=""

OTA_CHANNEL=""
OTA_VERSION=""
OTA_PARTS=()

TX_ID=""
TX_DIR=""
OTA_ISO=""
OTA_ISO_SHA256=""
ROOT_UUID=""
ROOT_FSTYPE=""
ESP_MOUNT=""
RECOVERY_PAYLOAD_DIR=""

C_RED=$'\033[0;31m'
C_GRN=$'\033[0;32m'
C_YEL=$'\033[0;33m'
C_BLU=$'\033[0;34m'
C_RST=$'\033[0m'


log() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true

    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') [$$] $1" \
        >> "$LOG_FILE" 2>/dev/null || true
}


info() {
    echo "${C_BLU}==>${C_RST} $*" >&2
    log "INFO: $*"
}


ok() {
    echo "${C_GRN}==>${C_RST} $*" >&2
    log "OK: $*"
}


warn() {
    echo "${C_YEL}==>${C_RST} $*" >&2
    log "WARN: $*"
}


err() {
    echo "${C_RED}==>${C_RST} $*" >&2
    log "ERROR: $*"
}


cleanup() {
    if [[ -d "$WORKDIR" ]]; then
        rm -rf "$WORKDIR"
    fi
}


die() {
    err "$*"
    exit 1
}


trap cleanup EXIT
trap 'die "Interrupted by signal."' INT TERM


require_root() {
    [[ "$(id -u)" -eq 0 ]] ||
        die "Administrator privileges required. Run with sudo."
}


require_cmd() {
    local missing=()

    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 ||
            missing+=("$cmd")
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        die "Missing required commands: ${missing[*]}"
    fi
}


check_dependencies() {
    require_cmd \
        bash \
        curl \
        jq \
        sha256sum \
        pacman \
        uname \
        grep \
        sed \
        awk \
        sort \
        find \
        tar \
        stat \
        flock \
        mktemp \
        install \
        tr \
        head \
        cat \
        dd \
        mount \
        umount \
        findmnt \
        blkid \
        rsync

    if ! command -v unzip >/dev/null 2>&1 &&
       ! command -v 7z >/dev/null 2>&1; then
        die "Neither unzip nor 7z is installed."
    fi
}


acquire_lock() {
    mkdir -p "$STATE_DIR"

    exec 200>"$LOCK_FILE"

    flock -n 200 ||
        die "Another instance of MUpdate is already running."
}


confirm() {
    [[ "$ASSUME_YES" == "1" ]] && return 0

    local reply

    read -r -p "${C_YEL}?${C_RST} $1 [y/N] " reply

    case "$reply" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}


print_version() {
    echo "mupdate version $VERSION"
}


verify_os_identity() {
    [[ -f /etc/os-release ]] ||
        die "/etc/os-release is missing."

    local id_val
    local id_like

    id_val="$(
        sed -n 's/^ID=//p' /etc/os-release |
        tr -d '"'
    )"

    id_like="$(
        sed -n 's/^ID_LIKE=//p' /etc/os-release |
        tr -d '"'
    )"

    if [[ "$id_val" != "mulios" || "$id_like" != *arch* ]]; then
        die "Incompatible OS: ID=$id_val ID_LIKE=$id_like. MUpdate $VERSION requires an Arch-based MuliOS installation."
    fi

    ok "MuliOS Arch system detected."
}


get_installed_version() {
    local ver

    ver="$(
        sed -n 's/^VERSION_ID=//p' /etc/os-release |
        tr -d '"'
    )"

    if [[ -z "$ver" ]]; then
        ver="$(
            sed -n 's/^VERSION=//p' /etc/os-release |
            tr -d '"'
        )"
    fi

    [[ -n "$ver" ]] ||
        die "Unable to determine installed MuliOS version."

    echo "$ver"
}


detect_kernel() {
    local kernel_string

    kernel_string="$(uname -r)"

    info "Running kernel: $kernel_string"

    if [[ "$kernel_string" =~ ^([0-9]+(\.[0-9]+)*)-([A-Za-z0-9_-]+)-([A-Za-z0-9_-]+)$ ]]; then
        KERNEL_VERSION="${BASH_REMATCH[1]}"
        OS_TAG="${BASH_REMATCH[3]}"
        CURRENT_PROFILE="${BASH_REMATCH[4],,}"

        info "Kernel version : $KERNEL_VERSION"
        info "OS tag         : $OS_TAG"
        info "Current profile: $CURRENT_PROFILE"
    else
        warn "Kernel does not match <version>-mulios-<profile>."

        KERNEL_VERSION="unknown"
        OS_TAG="unknown"
        CURRENT_PROFILE=""
    fi
}


check_profile_lock() {
    local target="${1,,}"

    if [[ "$FORCE" == "1" ]]; then
        warn "Force mode: bypassing profile lock."
        return 0
    fi

    if [[ -z "$CURRENT_PROFILE" ]]; then
        warn "Unable to determine the current kernel profile."

        confirm "Proceed with installing '$target'?" ||
            die "Aborted."

        return 0
    fi

    if [[ "$CURRENT_PROFILE" == "generic" ]]; then
        return 0
    fi

    if [[ "$CURRENT_PROFILE" == "$target" ]]; then
        return 0
    fi

    if [[ "$RESET" != "1" ]]; then
        die "Currently using profile '$CURRENT_PROFILE'. Switching to '$target' requires -r."
    fi

    warn "Profile reset requested: '$CURRENT_PROFILE' -> '$target'."
}


gh_api_get() {
    local path="$1"

    local url
    url="https://api.github.com/repos/${GITHUB_OWNER}/${GITHUB_REPO}/contents/${path}?ref=${GITHUB_BRANCH}"

    local tmp
    tmp="$(mktemp)"

    local curl_args=(
        -sS
        -o "$tmp"
        -w "%{http_code}"
        -H "Accept: application/vnd.github+json"
        -H "X-GitHub-Api-Version: 2022-11-28"
    )

    if [[ -n "$GITHUB_TOKEN" ]]; then
        curl_args+=(
            -H "Authorization: Bearer ${GITHUB_TOKEN}"
        )
    fi

    local http_code

    if ! http_code="$(
        curl "${curl_args[@]}" "$url"
    )"; then
        rm -f "$tmp"
        return 100
    fi

    case "$http_code" in
        200)
            cat "$tmp"
            rm -f "$tmp"
            return 0
            ;;

        404)
            rm -f "$tmp"
            return 404
            ;;

        429)
            rm -f "$tmp"
            return 429
            ;;

        *)
            rm -f "$tmp"
            return 500
            ;;
    esac
}


raw_url() {
    local path="$1"

    printf \
        'https://raw.githubusercontent.com/%s/%s/%s/%s\n' \
        "$GITHUB_OWNER" \
        "$GITHUB_REPO" \
        "$GITHUB_BRANCH" \
        "$path"
}


find_profile_dir() {
    local target="${1,,}"

    info "Querying live profiles directory..."

    local listing

    if ! listing="$(gh_api_get "profiles")"; then
        die "Unable to query GitHub profiles directory."
    fi

    PROFILE_DIR="$(
        echo "$listing" |
        jq -r '
            .[]?
            | select(.type == "dir")
            | .name
        ' |
        awk -v target="$target" '
            BEGIN { IGNORECASE=1 }
            tolower($0) == tolower(target) {
                print
                exit
            }
        '
    )"

    if [[ -z "$PROFILE_DIR" ]]; then
        die "Unknown MuliOS profile: '$target'. No matching directory exists in profiles/."
    fi

    ok "Remote profile directory: profiles/$PROFILE_DIR"
}


find_profile_zip() {
    local target="${1,,}"

    local listing

    if ! listing="$(gh_api_get "profiles/${PROFILE_DIR}")"; then
        die "Unable to query profiles/${PROFILE_DIR}."
    fi

    ZIP_NAME="$(
        echo "$listing" |
        jq -r '
            .[]?
            | select(.type == "file")
            | .name
        ' |
        awk -v target="$target" '
            BEGIN { IGNORECASE=1 }
            /\.zip$/ && index(tolower($0), tolower(target)) {
                print
                exit
            }
        '
    )"

    if [[ -z "$ZIP_NAME" ]]; then
        die "Profile '$target' exists, but no profile ZIP containing '$target' is currently available in profiles/$PROFILE_DIR/."
    fi

    ZIP_URL="$(
        raw_url "profiles/${PROFILE_DIR}/${ZIP_NAME}"
    )"

    ok "Profile ZIP: $ZIP_NAME"

    local base
    base="${ZIP_NAME%.zip}"

    CHECKSUM_NAME="$(
        echo "$listing" |
        jq -r '
            .[]?
            | select(.type == "file")
            | .name
        ' |
        awk -v base="$base" '
            BEGIN { IGNORECASE=1 }
            tolower($0) == tolower(base ".sha256") {
                print
                exit
            }
        '
    )"

    if [[ -n "$CHECKSUM_NAME" ]]; then
        CHECKSUM_URL="$(
            raw_url "profiles/${PROFILE_DIR}/${CHECKSUM_NAME}"
        )"

        ok "Profile checksum: $CHECKSUM_NAME"
    else
        CHECKSUM_URL=""
        warn "No checksum file found for $ZIP_NAME."
    fi
}


find_global_release() {
    info "Querying live global release..."

    local listing

    if ! listing="$(gh_api_get "global")"; then
        die "Unable to query global/."
    fi

    ZIP_NAME="$(
        echo "$listing" |
        jq -r '
            .[]?
            | select(.type == "file")
            | .name
        ' |
        awk '
            BEGIN { IGNORECASE=1 }
            tolower($0) == "release.zip" {
                print
                exit
            }
        '
    )"

    [[ -n "$ZIP_NAME" ]] ||
        die "global/release.zip was not found."

    ZIP_URL="$(
        raw_url "global/${ZIP_NAME}"
    )"

    CHECKSUM_NAME="$(
        echo "$listing" |
        jq -r '
            .[]?
            | select(.type == "file")
            | .name
        ' |
        awk '
            BEGIN { IGNORECASE=1 }
            tolower($0) == "release.sha256" {
                print
                exit
            }
        '
    )"

    if [[ -n "$CHECKSUM_NAME" ]]; then
        CHECKSUM_URL="$(
            raw_url "global/${CHECKSUM_NAME}"
        )"
    else
        CHECKSUM_URL=""
    fi

    ok "Global package: $ZIP_NAME"
}


download_zip() {
    ZIP_PATH="$WORKDIR/$ZIP_NAME"

    info "Downloading $ZIP_NAME..."

    curl \
        -fL \
        --retry 3 \
        --retry-all-errors \
        -o "$ZIP_PATH" \
        "$ZIP_URL" ||
        die "Failed downloading $ZIP_NAME."

    local size
    size="$(stat -c%s "$ZIP_PATH")"

    [[ "$size" -gt 0 ]] ||
        die "Downloaded ZIP is empty."

    info "Downloaded $(numfmt --to=iec "$size" 2>/dev/null || echo "$size bytes")."

    if [[ "$FORCE" == "1" ]]; then
        warn "Force mode: checksum verification skipped."
        return
    fi

    if [[ -n "$CHECKSUM_URL" ]]; then
        local checksum_file
        checksum_file="$WORKDIR/package.sha256"

        curl \
            -fL \
            --retry 3 \
            --retry-all-errors \
            -o "$checksum_file" \
            "$CHECKSUM_URL" ||
            die "Failed downloading checksum."

        local expected
        local actual

        expected="$(
            awk '
                NF {
                    print $1
                    exit
                }
            ' "$checksum_file"
        )"

        actual="$(
            sha256sum "$ZIP_PATH" |
            awk '{print $1}'
        )"

        [[ "$expected" =~ ^[[:xdigit:]]{64}$ ]] ||
            die "Invalid SHA-256 checksum file."

        [[ "$expected" == "$actual" ]] ||
            die "Checksum mismatch for $ZIP_NAME."

        ok "ZIP checksum verified."
    elif [[ "$SAFE_MODE" == "1" ]]; then
        die "Safe mode requires a .sha256 checksum."
    else
        warn "No checksum file found. Continuing without ZIP checksum verification."
    fi
}


extract_zip() {
    EXTRACT_DIR="$WORKDIR/extracted"

    mkdir -p "$EXTRACT_DIR"

    info "Extracting $ZIP_NAME..."

    if command -v unzip >/dev/null 2>&1; then
        unzip -q "$ZIP_PATH" -d "$EXTRACT_DIR" ||
            die "ZIP extraction failed."
    elif command -v 7z >/dev/null 2>&1; then
        7z x \
            -y \
            "-o$EXTRACT_DIR" \
            "$ZIP_PATH" >/dev/null ||
            die "ZIP extraction failed."
    else
        die "No ZIP extraction tool is available."
    fi

    local extracted_count

    extracted_count="$(
        find "$EXTRACT_DIR" \
            -type f |
        wc -l
    )"

    [[ "$extracted_count" -gt 0 ]] ||
        die "ZIP extraction produced no files."

    ok "ZIP extracted successfully."
}


find_script() {
    local name="$1"

    find "$EXTRACT_DIR" \
        -type f \
        -path '*/sh/'"$name" \
        -print \
        -quit
}


run_script() {
    local script="$1"

    [[ -f "$script" ]] ||
        die "Script does not exist: $script"

    chmod +x "$script"

    if [[ "$SAFE_MODE" == "1" ]]; then
        echo
        echo "${C_YEL}Preview: $(basename "$script")${C_RST}"
        sed -n '1,160p' "$script"
        echo
    fi

    confirm "Run $(basename "$script")?" ||
        die "Aborted."

    info "Running $(basename "$script")..."

    if (
        cd "$(dirname "$(dirname "$script")")"
        "$script"
    ); then
        ok "$(basename "$script") completed."
    else
        warn "$(basename "$script") failed."
        RUN_HAD_FAILURES=1

        [[ "$FORCE" == "1" ]] ||
            die "Profile script failed: $(basename "$script")"
    fi
}


run_profile_scripts() {
    local packages_script
    local install_script

    packages_script="$(find_script "packages.sh")"
    install_script="$(find_script "install.sh")"

    if [[ -z "$packages_script" && -z "$install_script" ]]; then
        die "No sh/packages.sh or sh/install.sh found in the profile package."
    fi

    if [[ "$SAFE_MODE" == "1" ]]; then
        info "Safe mode enabled."
        info "Scripts will be previewed before execution."
    fi

    if [[ -n "$packages_script" ]]; then
        info "Profile dependency script found: sh/packages.sh"
        run_script "$packages_script"
    else
        warn "sh/packages.sh was not found."
    fi

    if [[ -n "$install_script" ]]; then
        info "Kernel installation script found: sh/install.sh"
        run_script "$install_script"
    else
        die "sh/install.sh was not found. A profile kernel package cannot be installed without its official installer."
    fi
}


cmd_profile() {
    TARGET_PROFILE="${TARGET_PROFILE,,}"

    [[ "$TARGET_PROFILE" =~ ^[a-z0-9][a-z0-9_-]*$ ]] ||
        die "Invalid profile name: $TARGET_PROFILE"

    acquire_lock
    require_root
    check_dependencies
    verify_os_identity
    detect_kernel
    check_profile_lock "$TARGET_PROFILE"

    echo

    info "MUpdate $VERSION"
    info "Target profile: $TARGET_PROFILE"

    find_profile_dir "$TARGET_PROFILE"
    find_profile_zip "$TARGET_PROFILE"

    download_zip
    extract_zip

    echo

    info "Preparing official '$TARGET_PROFILE' profile package."

    run_profile_scripts

    if [[ "$RUN_HAD_FAILURES" == "1" ]]; then
        die "Profile installation completed with script failures."
    fi

    mkdir -p /etc/mupdate

    printf '%s\n' "$TARGET_PROFILE" \
        > /etc/mupdate/profile

    printf '%s\n' "$ZIP_NAME" \
        > /etc/mupdate/profile-package

    printf '%s\n' "$VERSION" \
        > /etc/mupdate/mupdate-version

    echo

    ok "MuliOS profile '$TARGET_PROFILE' installed successfully."
    warn "Reboot to start the newly installed kernel if the profile installer requested it."
}


cmd_install() {
    acquire_lock
    require_root
    check_dependencies
    verify_os_identity

    info "MUpdate global installation/update."

    find_global_release
    download_zip
    extract_zip

    run_profile_scripts

    if [[ "$RUN_HAD_FAILURES" == "1" ]]; then
        die "Global installation completed with script failures."
    fi

    ok "Global MuliOS installation/update completed."
}


validate_iso9660_header() {
    local iso="$1"

    [[ -f "$iso" ]] ||
        die "ISO file does not exist: $iso"

    local size
    size="$(stat -c%s "$iso")"

    [[ "$size" -ge 38000 ]] ||
        die "ISO is too small to be valid."

    local magic

    magic="$(
        dd \
            if="$iso" \
            bs=1 \
            skip=32769 \
            count=5 \
            2>/dev/null || true
    )"

    [[ "$magic" == "CD001" ]] ||
        die "ISO 9660 header validation failed."

    ok "ISO 9660 header verified."
}


validate_iso_structure() {
    local iso="$1"

    local mount_dir
    mount_dir="$WORKDIR/iso-check"

    mkdir -p "$mount_dir"

    info "Mounting reconstructed ISO for structural verification..."

    mount -o loop,ro "$iso" "$mount_dir" ||
        die "Unable to mount reconstructed MuliOS ISO."

    local found_root=0

    if [[ -f "$mount_dir/arch/x86_64/airootfs.sfs" ]]; then
        found_root=1
    fi

    if [[ -f "$mount_dir/mulios/x86_64/airootfs.sfs" ]]; then
        found_root=1
    fi

    if [[ "$found_root" != "1" ]]; then
        umount "$mount_dir" || true
        die "Reconstructed ISO does not contain a recognizable MuliOS airootfs."
    fi

    if [[ ! -f "$mount_dir/arch/boot/x86_64/vmlinuz-linux" &&
          ! -f "$mount_dir/mulios/boot/x86_64/vmlinuz-linux" ]]; then
        umount "$mount_dir" || true
        die "Reconstructed ISO does not contain a Linux kernel."
    fi

    if [[ ! -f "$mount_dir/arch/boot/x86_64/initramfs-linux.img" &&
          ! -f "$mount_dir/mulios/boot/x86_64/initramfs-linux.img" ]]; then
        umount "$mount_dir" || true
        die "Reconstructed ISO does not contain an initramfs."
    fi

    umount "$mount_dir"

    ok "MuliOS ISO structure verified."
}


discover_ota() {
    local channel="$1"
    local remote_path="latest/${channel}/arch"

    info "Querying OTA channel: $remote_path"

    local listing

    if ! listing="$(gh_api_get "$remote_path")"; then
        die "Unable to query OTA channel '$channel'."
    fi

    local parts=()
    local detected_version=""

    while IFS= read -r file; do
        [[ -n "$file" ]] || continue

        if [[ "$file" =~ ^MuliOS-([A-Za-z0-9.]+)-x86_64\.iso\.([0-9]+)$ ]]; then
            local version
            version="${BASH_REMATCH[1]}"

            if [[ -z "$detected_version" ]]; then
                detected_version="$version"
            elif [[ "$detected_version" != "$version" ]]; then
                die "OTA channel contains mixed ISO versions."
            fi

            parts+=("$file")
        fi
    done < <(
        echo "$listing" |
        jq -r '
            .[]?
            | select(.type == "file")
            | .name
        '
    )

    [[ -n "$detected_version" ]] ||
        die "No split MuliOS ISO found in $remote_path."

    mapfile -t OTA_PARTS < <(
        printf '%s\n' "${parts[@]}" |
        sort -V
    )

    local expected=1

    for part in "${OTA_PARTS[@]}"; do
        local number
        number="${part##*.}"

        [[ "$((10#$number))" -eq "$expected" ]] ||
            die "OTA ISO parts are discontinuous."

        expected=$((expected + 1))
    done

    OTA_VERSION="$detected_version"

    ok "OTA version: $OTA_VERSION"
    ok "OTA parts: ${#OTA_PARTS[@]}"
}


detect_root_filesystem() {
    local root_source

    root_source="$(findmnt -n -o SOURCE /)" ||
        die "Unable to determine the root filesystem."

    ROOT_UUID="$(findmnt -n -o UUID / 2>/dev/null || true)"

    if [[ -z "$ROOT_UUID" ]]; then
        local device

        device="$root_source"

        if [[ "$device" == *"["* ]]; then
            device="${device%%[*}"
        fi

        ROOT_UUID="$(
            blkid -s UUID -o value "$device" 2>/dev/null || true
        )"
    fi

    [[ -n "$ROOT_UUID" ]] ||
        die "Unable to determine root filesystem UUID."

    ROOT_FSTYPE="$(
        findmnt -n -o FSTYPE /
    )"

    [[ -n "$ROOT_FSTYPE" ]] ||
        die "Unable to determine root filesystem type."

    info "Root filesystem UUID : $ROOT_UUID"
    info "Root filesystem type : $ROOT_FSTYPE"
}


detect_esp() {
    local candidate

    ESP_MOUNT=""

    while IFS= read -r candidate; do
        [[ -n "$candidate" ]] || continue

        if [[ -d "$candidate/EFI" ]]; then
            ESP_MOUNT="$candidate"
            break
        fi
    done < <(
        findmnt -rn -t vfat -o TARGET
    )

    if [[ -z "$ESP_MOUNT" ]]; then
        for candidate in /efi /boot/efi /boot; do
            if mountpoint -q "$candidate" &&
               findmnt -n -t vfat "$candidate" >/dev/null 2>&1 &&
               [[ -d "$candidate/EFI" ]]; then
                ESP_MOUNT="$candidate"
                break
            fi
        done
    fi

    [[ -n "$ESP_MOUNT" ]] ||
        die "Unable to locate the EFI System Partition."

    info "EFI System Partition: $ESP_MOUNT"
}


find_recovery_iso() {
    local found

    found="$(
        compgen -G "$RECOVERY_ISO_GLOB" |
        sort -V |
        tail -n 1 || true
    )"

    if [[ -z "$found" ]]; then
        die "MuliRecovery ISO not found.

Expected:
  $RECOVERY_ISO_GLOB

Build MuliRecovery first and place the resulting ISO in:
  $RECOVERY_ISO_DIR"
    fi

    [[ -f "$found" ]] ||
        die "MuliRecovery ISO does not exist: $found"

    RECOVERY_ISO="$found"

    ok "MuliRecovery ISO: $RECOVERY_ISO"
}


install_recovery_payload() {
    detect_esp
    find_recovery_iso

    local mount_dir
    mount_dir="$WORKDIR/recovery-iso"

    mkdir -p "$mount_dir"

    info "Mounting MuliRecovery ISO..."

    mount -o loop,ro "$RECOVERY_ISO" "$mount_dir" ||
        die "Unable to mount MuliRecovery ISO."

    local source_dir

    if [[ -d "$mount_dir/mulirecovery" ]]; then
        source_dir="$mount_dir/mulirecovery"
    else
        umount "$mount_dir" || true
        die "MuliRecovery ISO does not contain /mulirecovery."
    fi

    if [[ ! -f "$source_dir/boot/x86_64/vmlinuz-linux" ]]; then
        umount "$mount_dir" || true
        die "MuliRecovery ISO kernel is missing."
    fi

    if [[ ! -f "$source_dir/boot/x86_64/initramfs-linux.img" ]]; then
        umount "$mount_dir" || true
        die "MuliRecovery ISO initramfs is missing."
    fi

    if [[ ! -f "$source_dir/x86_64/airootfs.sfs" ]]; then
        umount "$mount_dir" || true
        die "MuliRecovery ISO root filesystem is missing."
    fi

    RECOVERY_PAYLOAD_DIR="$ESP_MOUNT/EFI/MuliRecovery"

    info "Installing MuliRecovery payload to:"
    info "$RECOVERY_PAYLOAD_DIR"

    rm -rf "$RECOVERY_PAYLOAD_DIR"
    mkdir -p "$RECOVERY_PAYLOAD_DIR"

    rsync \
        -aH \
        --delete \
        "$source_dir/" \
        "$RECOVERY_PAYLOAD_DIR/" ||
        die "Failed installing MuliRecovery payload."

    umount "$mount_dir"

    ok "MuliRecovery payload installed to the ESP."
}


write_systemd_boot_entry() {
    detect_esp

    command -v bootctl >/dev/null 2>&1 ||
        return 1

    local loader_dir="$ESP_MOUNT/loader"
    local entry_dir="$loader_dir/entries"
    local entry="$entry_dir/mulirecovery.conf"

    [[ -d "$loader_dir" ]] ||
        return 1

    mkdir -p "$entry_dir"

    cat > "$entry" <<'EOF'
title   MuliOS Recovery
linux   /EFI/MuliRecovery/boot/x86_64/vmlinuz-linux
initrd  /EFI/MuliRecovery/boot/x86_64/initramfs-linux.img
options archisobasedir=/EFI/MuliRecovery archisosearchfilename=/EFI/MuliRecovery/boot/x86_64/vmlinuz-linux quiet loglevel=0 systemd.show_status=0 rd.systemd.show_status=0 vt.global_cursor_default=0
EOF

    ok "MuliRecovery systemd-boot entry created."

    if bootctl --esp-path="$ESP_MOUNT" set-oneshot mulirecovery.conf >/dev/null 2>&1; then
        ok "MuliRecovery configured as the next boot."
        return 0
    fi

    if bootctl set-oneshot mulirecovery.conf >/dev/null 2>&1; then
        ok "MuliRecovery configured as the next boot."
        return 0
    fi

    warn "systemd-boot entry was created, but set-oneshot failed."
    return 1
}


write_grub_entry() {
    command -v grub-mkconfig >/dev/null 2>&1 ||
        return 1

    command -v grub-reboot >/dev/null 2>&1 ||
        return 1

    [[ -d /boot/grub ]] ||
        return 1

    local root_uuid="$ROOT_UUID"

    local grub_script="/etc/grub.d/41_mupdate_recovery"

    cat > "$grub_script" <<EOF
#!/bin/sh

cat <<'GRUB_ENTRY'
menuentry 'MuliOS Recovery' --id 'mulirecovery' {
    search --no-floppy --fs-uuid --set=root ${root_uuid}
    linux /boot/mulirecovery/boot/x86_64/vmlinuz-linux archisobasedir=/boot/mulirecovery archisosearchfilename=/boot/mulirecovery/boot/x86_64/vmlinuz-linux quiet loglevel=0 systemd.show_status=0 rd.systemd.show_status=0 vt.global_cursor_default=0
    initrd /boot/mulirecovery/boot/x86_64/initramfs-linux.img
}
GRUB_ENTRY
EOF

    chmod 755 "$grub_script"

    local target="/boot/mulirecovery"

    rm -rf "$target"
    mkdir -p "$target"

    local mount_dir="$WORKDIR/recovery-grub-iso"
    mkdir -p "$mount_dir"

    mount -o loop,ro "$RECOVERY_ISO" "$mount_dir" ||
        die "Unable to mount MuliRecovery ISO for GRUB."

    [[ -d "$mount_dir/mulirecovery" ]] ||
        die "MuliRecovery payload directory missing."

    rsync \
        -aH \
        --delete \
        "$mount_dir/mulirecovery/" \
        "$target/" ||
        die "Failed copying MuliRecovery payload to /boot."

    umount "$mount_dir"

    info "Regenerating GRUB configuration..."

    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null ||
        die "grub-mkconfig failed."

    grub-reboot "mulirecovery" ||
        die "Unable to configure GRUB one-shot recovery boot."

    ok "MuliRecovery configured as the next GRUB boot."

    return 0
}


configure_recovery_boot() {
    local systemd_boot_success=0
    local grub_success=0

    if write_systemd_boot_entry; then
        systemd_boot_success=1
    fi

    if [[ "$systemd_boot_success" == "0" ]]; then
        if write_grub_entry; then
            grub_success=1
        fi
    fi

    if [[ "$systemd_boot_success" == "0" &&
          "$grub_success" == "0" ]]; then

        die "Unable to configure one-shot MuliRecovery boot.

MUpdate currently supports:
  - systemd-boot
  - GRUB

The recovery payload has been installed, but no bootloader was configured.
The system has NOT been rebooted."
    fi
}


backup_users() {
    mkdir -p "$BACKUP_DIR"

    local backup_archive
    backup_archive="$BACKUP_DIR/users_${TX_ID}.tar.gz"

    info "Backing up user data..."

    local tar_items=()

    [[ -d /home ]] && tar_items+=("home")
    [[ -d /root ]] && tar_items+=("root")

    [[ ${#tar_items[@]} -gt 0 ]] ||
        die "No user directories were found to back up."

    tar \
        --acls \
        --xattrs \
        --xattrs-include='*' \
        --numeric-owner \
        --one-file-system \
        -czf "$backup_archive" \
        -C / \
        "${tar_items[@]}" ||
        die "Failed to create user backup."

    [[ -s "$backup_archive" ]] ||
        die "User backup is empty."

    local backup_sha

    backup_sha="$(
        sha256sum "$backup_archive" |
        awk '{print $1}'
    )"

    printf '%s\n' "$backup_sha" \
        > "${backup_archive}.sha256"

    ok "User backup created:"
    ok "$backup_archive"

    printf '%s\n' "$backup_archive"
}


backup_configuration() {
    local config_archive
    config_archive="$BACKUP_DIR/config_${TX_ID}.tar.gz"

    info "Backing up MuliOS configuration..."

    local config_items=()

    [[ -d /etc ]] && config_items+=("etc")
    [[ -d /var/lib ]] && config_items+=("var/lib")

    if [[ ${#config_items[@]} -eq 0 ]]; then
        warn "No configuration directories available."
        return
    fi

    tar \
        --acls \
        --xattrs \
        --xattrs-include='*' \
        --numeric-owner \
        --one-file-system \
        --exclude='var/lib/mupdate/backups' \
        --exclude='var/lib/mupdate/transaction' \
        -czf "$config_archive" \
        -C / \
        "${config_items[@]}" ||
        die "Failed to create configuration backup."

    local config_sha

    config_sha="$(
        sha256sum "$config_archive" |
        awk '{print $1}'
    )"

    printf '%s\n' "$config_sha" \
        > "${config_archive}.sha256"

    ok "Configuration backup created."
}


create_transaction() {
    mkdir -p "$TX_DIR"

    local backup_archive="$1"
    local config_archive="$2"

    local installed_version
    installed_version="$(get_installed_version)"

    local iso_sha
    iso_sha="$(
        sha256sum "$OTA_ISO" |
        awk '{print $1}'
    )"

    OTA_ISO_SHA256="$iso_sha"

    local recovery_iso_sha=""
    recovery_iso_sha="$(
        sha256sum "$RECOVERY_ISO" |
        awk '{print $1}'
    )"

    cat > "$TX_DIR/transaction" <<EOF
# MUpdate persistent recovery transaction.
# Generated automatically. Do not edit.

MUPDATE_TRANSACTION_VERSION=1
MUPDATE_RECOVERY=1

TRANSACTION_ID=$(printf '%q' "$TX_ID")

MUPDATE_CHANNEL=$(printf '%q' "$OTA_CHANNEL")
MUPDATE_TARGET=$(printf '%q' "$OTA_VERSION")
MUPDATE_INSTALLED_VERSION=$(printf '%q' "$installed_version")

MUPDATE_ISO=$(printf '%q' "$OTA_ISO")
MUPDATE_ISO_SHA256=$(printf '%q' "$OTA_ISO_SHA256")

MUPDATE_RECOVERY_ISO=$(printf '%q' "$RECOVERY_ISO")
MUPDATE_RECOVERY_ISO_SHA256=$(printf '%q' "$recovery_iso_sha")

MUPDATE_ROOT_UUID=$(printf '%q' "$ROOT_UUID")
MUPDATE_ROOT_FSTYPE=$(printf '%q' "$ROOT_FSTYPE")

MUPDATE_BACKUP=$(printf '%q' "$backup_archive")
MUPDATE_CONFIG_BACKUP=$(printf '%q' "$config_archive")

MUPDATE_STATUS=staged
MUPDATE_MERGE_MODE=preserve-setup
EOF

    chmod 600 "$TX_DIR/transaction"

    ln -sfn "$TX_DIR/transaction" \
        "$TRANS_DIR/transaction"

    cat > "$TX_DIR/state" <<EOF
staged
EOF

    cat > "$TX_DIR/metadata.json" <<EOF
{
  "transaction_id": "$TX_ID",
  "status": "staged",
  "channel": "$OTA_CHANNEL",
  "installed_version": "$installed_version",
  "target_version": "$OTA_VERSION",
  "iso": "$OTA_ISO",
  "iso_sha256": "$OTA_ISO_SHA256",
  "recovery_iso": "$RECOVERY_ISO",
  "root_uuid": "$ROOT_UUID",
  "root_fstype": "$ROOT_FSTYPE",
  "backup": "$backup_archive",
  "config_backup": "$config_archive",
  "merge_mode": "preserve-setup"
}
EOF

    chmod 600 "$TX_DIR/metadata.json"

    ok "Persistent recovery transaction created."
}


verify_transaction() {
    [[ -f "$TX_DIR/transaction" ]] ||
        die "Recovery transaction was not created."

    [[ -f "$TX_DIR/metadata.json" ]] ||
        die "Recovery transaction metadata was not created."

    [[ -f "$OTA_ISO" ]] ||
        die "Staged OTA ISO is missing."

    [[ -f "$TX_DIR/transaction" ]] ||
        die "Transaction file missing."

    local actual

    actual="$(
        sha256sum "$OTA_ISO" |
        awk '{print $1}'
    )"

    [[ "$actual" == "$OTA_ISO_SHA256" ]] ||
        die "Final OTA ISO checksum changed after staging."

    ok "Persistent OTA transaction verified."
}


prepare_recovery_transaction() {
    local transaction_copy

    transaction_copy="$ESP_MOUNT/EFI/MuliRecovery/mupdate.transaction"

    install \
        -m 600 \
        "$TX_DIR/transaction" \
        "$transaction_copy"

    ok "Recovery transaction copied to MuliRecovery payload."
}


request_reboot() {
    echo
    echo "MUpdate $VERSION — OTA READY"
    echo
    echo "Channel       : $OTA_CHANNEL"
    echo "Current       : $(get_installed_version)"
    echo "Target        : $OTA_VERSION"
    echo "ISO           : $OTA_ISO"
    echo "ISO SHA-256   : $OTA_ISO_SHA256"
    echo "Transaction   : $TX_ID"
    echo "Backup        : $TX_DIR"
    echo
    echo "The next boot will enter MuliRecovery."
    echo "MuliRecovery will:"
    echo
    echo "  1. Mount the installed MuliOS system"
    echo "  2. Read the persistent transaction"
    echo "  3. Load the user/configuration backups"
    echo "  4. Verify the OTA ISO again"
    echo "  5. Merge the new MuliOS release"
    echo "  6. Preserve the existing setup"
    echo "  7. Restore user data"
    echo "  8. Regenerate initramfs and boot configuration"
    echo "  9. Verify the resulting installation"
    echo " 10. Remove the one-shot recovery boot"
    echo " 11. Reboot into the updated MuliOS system"
    echo

    confirm "Reboot into MuliRecovery now?" ||
        die "OTA is staged but reboot was cancelled.

Transaction:
  $TX_DIR/transaction"

    sync

    ok "Rebooting into MuliRecovery..."

    systemctl reboot
}


cmd_ota() {
    local channel="$1"

    [[ "$channel" == "beta" ||
       "$channel" == "stable" ]] ||
        die "OTA channel must be beta or stable."

    acquire_lock
    require_root
    check_dependencies
    verify_os_identity
    detect_root_filesystem

    discover_ota "$channel"

    TX_ID="$(date -u '+%Y%m%d_%H%M%S')_$$"

    TX_DIR="$TRANS_DIR/$TX_ID"

    local workspace
    workspace="$TX_DIR/workspace"

    mkdir -p "$workspace"

    info "Downloading OTA parts..."

    for part in "${OTA_PARTS[@]}"; do
        local destination
        destination="$workspace/$part"

        local url
        url="$(
            raw_url "latest/${channel}/arch/${part}"
        )"

        info "Downloading $part..."

        curl \
            -fL \
            --retry 3 \
            --retry-all-errors \
            -o "$destination" \
            "$url" ||
            die "Failed downloading $part."

        [[ -s "$destination" ]] ||
            die "Downloaded OTA part is empty: $part"

        ok "Downloaded $part."
    done

    OTA_ISO="$TX_DIR/MuliOS-${OTA_VERSION}-x86_64.iso"

    info "Reassembling ISO..."

    : > "$OTA_ISO"

    for part in "${OTA_PARTS[@]}"; do
        cat "$workspace/$part" >> "$OTA_ISO"
    done

    [[ -s "$OTA_ISO" ]] ||
        die "Reassembled OTA ISO is empty."

    validate_iso9660_header "$OTA_ISO"
    validate_iso_structure "$OTA_ISO"

    OTA_ISO_SHA256="$(
        sha256sum "$OTA_ISO" |
        awk '{print $1}'
    )"

    ok "OTA ISO SHA-256:"
    ok "$OTA_ISO_SHA256"

    backup_users
    local backup_archive
    backup_archive="$BACKUP_DIR/users_${TX_ID}.tar.gz"

    backup_configuration
    local config_archive
    config_archive="$BACKUP_DIR/config_${TX_ID}.tar.gz"

    install_recovery_payload

    create_transaction \
        "$backup_archive" \
        "$config_archive"

    prepare_recovery_transaction

    verify_transaction

    configure_recovery_boot

    printf '%s\n' "$channel" \
        > "$CHANNEL_FILE"

    cat > "$TRANS_DIR/latest.json" <<EOF
{
  "transaction_id": "$TX_ID",
  "status": "ready-for-recovery",
  "channel": "$channel",
  "target_version": "$OTA_VERSION",
  "iso": "$OTA_ISO",
  "iso_sha256": "$OTA_ISO_SHA256",
  "root_uuid": "$ROOT_UUID",
  "root_fstype": "$ROOT_FSTYPE",
  "backup": "$backup_archive",
  "config_backup": "$config_archive",
  "recovery_iso": "$RECOVERY_ISO",
  "merge_mode": "preserve-setup"
}
EOF

    sync

    request_reboot
}


cmd_status() {
    require_root
    check_dependencies

    echo "MUpdate $VERSION"
    echo

    if [[ -f "$CHANNEL_FILE" ]]; then
        echo "OTA Channel       : $(cat "$CHANNEL_FILE")"
    else
        echo "OTA Channel       : unknown"
    fi

    echo "Running Kernel    : $(uname -r)"

    if [[ -f /etc/mupdate/profile ]]; then
        echo "MuliOS Profile    : $(cat /etc/mupdate/profile)"
    else
        echo "MuliOS Profile    : unknown"
    fi

    if [[ -f /etc/mupdate/profile-package ]]; then
        echo "Profile Package   : $(cat /etc/mupdate/profile-package)"
    fi

    if [[ -f "$TRANS_DIR/latest.json" ]]; then
        echo
        echo "OTA Transaction:"
        jq . "$TRANS_DIR/latest.json"
    else
        echo
        echo "OTA Transaction   : none"
    fi

    if [[ -L "$TRANS_DIR/transaction" ||
          -f "$TRANS_DIR/transaction" ]]; then
        echo
        echo "Recovery Transaction:"
        echo "  $TRANS_DIR/transaction"

        if [[ -f "$TRANS_DIR/transaction" ]]; then
            sed -n '1,160p' "$TRANS_DIR/transaction"
        fi
    fi
}


cmd_cancel() {
    require_root

    if [[ ! -f "$TRANS_DIR/latest.json" ]]; then
        info "No OTA transaction exists."
        return
    fi

    local iso

    iso="$(
        jq -r '.iso // empty' "$TRANS_DIR/latest.json"
    )"

    if [[ -n "$iso" && -f "$iso" ]]; then
        rm -f "$iso"
    fi

    if [[ -L "$TRANS_DIR/transaction" ]]; then
        local transaction_target
        transaction_target="$(
            readlink -f "$TRANS_DIR/transaction" 2>/dev/null || true
        )"

        if [[ -n "$transaction_target" &&
              -f "$transaction_target" ]]; then

            local transaction_dir
            transaction_dir="$(dirname "$transaction_target")"

            rm -rf "$transaction_dir"
        fi

        rm -f "$TRANS_DIR/transaction"
    fi

    rm -f "$TRANS_DIR/latest.json"

    ok "OTA transaction cancelled."
}


cmd_check() {
    require_root
    check_dependencies
    verify_os_identity

    local channel="beta"

    if [[ -f "$CHANNEL_FILE" ]]; then
        channel="$(cat "$CHANNEL_FILE")"
    fi

    [[ "$channel" == "beta" ||
       "$channel" == "stable" ]] ||
        channel="beta"

    discover_ota "$channel"

    local installed
    installed="$(get_installed_version)"

    echo
    echo "Installed MuliOS : $installed"
    echo "OTA Channel      : $channel"
    echo "Available OTA    : $OTA_VERSION"
}


show_help() {
    cat <<EOF
MUpdate $VERSION — MuliOS Arch OTA + Kernel Profile Manager

GLOBAL INSTALL
  sudo mupdate install

KERNEL PROFILES
  sudo mupdate <profile>
  sudo mupdate <profile> -r
  sudo mupdate <profile> -y
  sudo mupdate <profile> -s
  sudo mupdate <profile> -f
  sudo mupdate <profile> setup

OTA
  sudo mupdate ota beta
  sudo mupdate ota stable

OTA FLOW
  MUpdate performs:

    1. Discover split MuliOS ISO
    2. Download every ISO part
    3. Verify part continuity
    4. Reassemble the ISO
    5. Verify ISO 9660 structure
    6. Calculate ISO SHA-256
    7. Backup /home
    8. Backup /root
    9. Backup /etc and /var/lib
   10. Prepare persistent transaction
   11. Install MuliRecovery to the ESP
   12. Create a one-shot recovery boot
   13. Reboot into MuliRecovery

RECOVERY
  MuliRecovery performs the offline update.

  It receives:

    - OTA ISO
    - ISO SHA-256
    - root filesystem UUID
    - root filesystem type
    - user backup
    - configuration backup
    - target release
    - transaction ID

MERGE MODE
  The recovery engine uses:

    preserve-setup

  User data and existing configuration are preserved.

  The new MuliOS release is merged into the
  existing installation instead of performing
  a normal live installer installation.

PROFILE DISCOVERY
  GitHub:
    ${GITHUB_OWNER}/${GITHUB_REPO}

  Profiles:
    profiles/<profile>/

PROFILE PACKAGE
  A profile ZIP may contain:

    linux-mulios-*.pkg.tar.zst
    linux-mulios-*-headers-*.pkg.tar.zst
    sh/packages.sh
    sh/install.sh

  MUpdate runs:

    1. sh/packages.sh
    2. sh/install.sh

INFORMATION
  sudo mupdate status
  sudo mupdate --check
  sudo mupdate cancel

  mupdate --version
  mupdate --help

RECOVERY ISO
  MUpdate expects a built MuliRecovery ISO at:

    ${RECOVERY_ISO_DIR}/MuliRecovery-*-x86_64.iso

  Override the discovery pattern with:

    RECOVERY_ISO_GLOB=/path/to/MuliRecovery-*.iso
EOF
}


if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi


for arg in "$@"; do
    case "$arg" in
        --version|-v)
            print_version
            exit 0
            ;;
    esac
done


COMMAND=""
TARGET_PROFILE=""


while [[ $# -gt 0 ]]; do
    case "$1" in

        --help|-h)
            show_help
            exit 0
            ;;

        --version|-v)
            print_version
            exit 0
            ;;

        --check)
            [[ -z "$COMMAND" ]] ||
                die "Unexpected argument: --check."

            COMMAND="check"
            ;;

        --apply)
            die "--apply is obsolete. OTA installation is performed by MuliRecovery."
            ;;

        --repair)
            die "--repair is not available outside MuliRecovery."
            ;;

        status)
            [[ -z "$COMMAND" ]] ||
                die "Unexpected argument: status."

            COMMAND="status"
            ;;

        cancel)
            [[ -z "$COMMAND" ]] ||
                die "Unexpected argument: cancel."

            COMMAND="cancel"
            ;;

        install)
            [[ -z "$COMMAND" ]] ||
                die "Unexpected argument: install."

            COMMAND="install"
            ;;

        ota)
            [[ -z "$COMMAND" ]] ||
                die "Unexpected argument: ota."

            COMMAND="ota"
            shift

            [[ $# -gt 0 ]] ||
                die "Missing OTA channel."

            OTA_CHANNEL="$1"

            [[ "$OTA_CHANNEL" == "beta" ||
               "$OTA_CHANNEL" == "stable" ]] ||
                die "OTA channel must be beta or stable."

            ;;

        setup)
            [[ "$COMMAND" == "profile" ]] ||
                die "'setup' must follow a profile name."

            ASSUME_YES=1
            ;;

        -y|--yes)
            ASSUME_YES=1
            ;;

        -s|--safe)
            SAFE_MODE=1
            ;;

        -f|--force)
            FORCE=1
            ASSUME_YES=1
            ;;

        -r|--reset)
            RESET=1
            ;;

        -*)
            die "Unknown option: $1"
            ;;

        *)
            if [[ -n "$COMMAND" ]]; then
                die "Unexpected argument: $1"
            fi

            COMMAND="profile"
            TARGET_PROFILE="$1"
            ;;
    esac

    shift
done


if [[ "$SAFE_MODE" == "1" &&
      "$FORCE" == "1" ]]; then

    die "-s/--safe and -f/--force cannot be used together."
fi


case "$COMMAND" in

    install)
        cmd_install
        ;;

    profile)
        cmd_profile
        ;;

    ota)
        cmd_ota "$OTA_CHANNEL"
        ;;

    check)
        cmd_check
        ;;

    status)
        cmd_status
        ;;

    cancel)
        cmd_cancel
        ;;

    *)
        die "No valid command specified."
        ;;

esac